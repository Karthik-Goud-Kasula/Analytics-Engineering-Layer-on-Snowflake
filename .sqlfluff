[sqlfluff]
templater = dbt
dialect = snowflake
max_line_length = 120
# RF01: sqlfluff cannot resolve dbt ref() targets, so it reports false
#       "reference not found" errors on joins.
# RF04: SEC column names such as `value`, `tag` and `version` are keywords in
#       some dialects but valid identifiers here.
# AM04: `select *` from a CTE is intentional in staging and final CTEs.
# ST06: column order follows the business meaning (keys, attributes, measures),
#       not "simple columns first".
# ST07: explicit ON clauses are preferred over USING for portability.
exclude_rules = RF01, RF04, AM04, ST06, ST07

[sqlfluff:indentation]
tab_space_size = 4
indented_joins = false
indented_using_on = true
template_blocks_indent = false

[sqlfluff:templater:dbt]
# Templating uses the offline DuckDB target, so linting needs no credentials.
# The dialect above is still Snowflake: the rendered SQL is checked against
# Snowflake grammar, except inside dispatched macros (see .sqlfluffignore).
project_dir = ./
profiles_dir = ./profiles
profile = sec_analytics
target = local

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = lower

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

[sqlfluff:rules:ambiguous.column_references]
group_by_and_order_by_style = consistent
