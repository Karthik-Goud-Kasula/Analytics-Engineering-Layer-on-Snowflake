# Copy to .env and fill in. .env is git-ignored and is loaded automatically by
# dbt (1.12+), by `make`, and by the loader. Never commit real values.
#
# Nothing here is needed for the default local (DuckDB) target.

# --- Which dbt target to use: local (DuckDB, default) | dev (Snowflake) ------
DBT_TARGET=local

# --- Snowflake (only for TARGET=dev) ------------------------------------------
# Account identifier in <orgname>-<account_name> form, e.g. myorg-myaccount
SNOWFLAKE_ACCOUNT=karthikgoudkasulab
# User that holds the SEC_TRANSFORMER role (and SEC_LOADER, to load data)
SNOWFLAKE_USER=karthikgoudkasulab
# Key-pair auth. Snowflake is blocking password-only sign-in for service users,
# so this project does not support passwords. See README > Snowflake setup.
# Use an ABSOLUTE path: dbt opens this file as-is and does not expand "~".
SNOWFLAKE_PRIVATE_KEY_PATH=/Users/yourname/.ssh/snowflake_rsa_key.p8
# Leave empty if the private key is not encrypted
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Defaults match snowflake/setup/01_account_setup.sql. Change only if you renamed objects.
SNOWFLAKE_DATABASE=SEC_ANALYTICS_DEV
SNOWFLAKE_WAREHOUSE=SEC_TRANSFORM_WH
SNOWFLAKE_ROLE=SEC_TRANSFORMER
SNOWFLAKE_LOADER_ROLE=SEC_LOADER
# Your personal dbt schema prefix (models land in <prefix>_staging, <prefix>_marts, ...)
DBT_SNOWFLAKE_SCHEMA=dbt_yourname

# --- SEC download (only for --source sec) -------------------------------------
# SEC requires a User-Agent identifying you: "Your Name your.email@example.com"
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=
