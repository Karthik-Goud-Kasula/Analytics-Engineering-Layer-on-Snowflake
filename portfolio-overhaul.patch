+version: 2
+
+sources:
+  - name: sec
+    description: >
+      SEC Financial Statement Data Sets, loaded unmodified by
+      ingestion/load_sec_data.py into the raw schema. Every source column is
+      VARCHAR; the loader appends _source_quarter, _source_file and _loaded_at.
+      Layout reference: https://www.sec.gov/files/financial-statement-data-sets.pdf
+    database: "{{ target.database }}"
+    schema: "{{ var('raw_schema') }}"
+    config:
+      loaded_at_field: _loaded_at
+      # The SEC publishes quarterly. A gap of more than one quarter since the
+      # last load means a scheduled load has been missed.
+      freshness:
+        warn_after: {count: 100, period: day}
+        error_after: {count: 200, period: day}
+
+    tables:
+      - name: sub
+        description: Submissions. One row per filing (accession number).
+        columns:
+          - name: adsh
+            description: Accession number, the filing's unique identifier.
+            data_tests:
+              - not_null
+              - unique
+
+      - name: num
+        description: >
+          Numeric facts. One row per (adsh, tag, version, ddate, qtrs, uom,
+          segments, coreg).
+        columns:
+          - name: adsh
+            data_tests:
+              - not_null
+
+      - name: tag
+        description: >
+          XBRL tag dictionary. Standard tags are repeated in every quarter's
+          file, so (tag, version) is unique per quarter, not overall.
+
+      - name: pre
+        description: Presentation. One row per (adsh, report, line).
diff --git a/models/staging/sec/stg_sec__numeric_facts.sql b/models/staging/sec/stg_sec__numeric_facts.sql
new file mode 100644
index 0000000..41818a2
--- /dev/null
+++ b/models/staging/sec/stg_sec__numeric_facts.sql
@@ -0,0 +1,50 @@
+/*
+    One row per numeric fact, at the SEC's native eight-column grain:
+
+        adsh, tag, version, ddate, qtrs, uom, segments, coreg
+
+    `fact_key` hashes all eight so the grain is tested, not assumed. Dropping any
+    one of them silently merges facts that must stay separate:
+
+        ddate    -> prior-year comparatives merge into the current year
+        qtrs     -> annual and quarterly figures collapse together
+        segments -> segment breakdowns (added to the files in Dec 2024) are
+                    summed into the consolidated total
+        coreg    -> a subsidiary's figures merge into the parent's
+
+    The raw value is kept next to the parsed one so unparseable values can be
+    reported (assert_numeric_values_parse) instead of silently disappearing.
+*/
+
+with source as (
+
+    select * from {{ source('sec', 'num') }}
+
+),
+
+renamed as (
+
+    select
+        {{ dbt_utils.generate_surrogate_key([
+            'adsh', 'tag', 'version', 'ddate', 'qtrs', 'uom', 'segments', 'coreg'
+        ]) }} as fact_key,
+        adsh as filing_id,
+        tag,
+        version as tag_version,
+        {{ parse_yyyymmdd('ddate') }} as period_end_date,
+        try_cast(qtrs as integer) as duration_quarters,
+        uom as unit_of_measure,
+        segments,
+        coreg as coregistrant,
+        segments is null and coreg is null as is_consolidated,
+        try_cast(value as decimal(28, 4)) as fact_value,
+        value as fact_value_raw,
+        footnote,
+        _source_quarter as source_quarter,
+        _loaded_at as loaded_at
+
+    from source
+
+)
+
+select * from renamed
diff --git a/models/staging/sec/stg_sec__presentation.sql b/models/staging/sec/stg_sec__presentation.sql
