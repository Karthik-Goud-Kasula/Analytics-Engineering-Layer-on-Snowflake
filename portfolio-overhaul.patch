diff --git a/models/marts/finance/fct_yoy_growth.sql b/models/marts/finance/fct_yoy_growth.sql
new file mode 100644
index 0000000..27ef8ef
--- /dev/null
+++ b/models/marts/finance/fct_yoy_growth.sql
@@ -0,0 +1,86 @@
+/*
+    Year-over-year growth, one row per company-year.
+
+    Grain: one row per (cik, fiscal_year).
+
+    The prior year is found with a self-join on fiscal_year - 1, not lag():
+    lag() returns the previous ROW, so a company with a missing year would get
+    a two-year change labelled as one-year growth.
+
+    Growth is a fraction (0.17 = 17%) and is NULL when the prior-year base is
+    zero or negative: growth "from -$5M to $10M" has no meaningful percentage.
+*/
+
+with annual as (
+
+    select
+        annual_financials_key,
+        company_key,
+        cik,
+        company_name,
+        sector,
+        fiscal_year,
+        revenue,
+        operating_income,
+        net_income,
+        operating_cash_flow,
+        total_assets
+    from {{ ref('fct_company_financials_annual') }}
+
+)
+
+select
+    current_year.annual_financials_key,
+    current_year.company_key,
+    current_year.cik,
+    current_year.company_name,
+    current_year.sector,
+    current_year.fiscal_year,
+    prior_year.fiscal_year is not null as has_prior_year,
+
+    current_year.revenue,
+    prior_year.revenue as prior_revenue,
+    case
+        when prior_year.revenue > 0
+            then {{ safe_divide('current_year.revenue - prior_year.revenue', 'prior_year.revenue') }}
+    end as revenue_growth_rate,
+
+    current_year.operating_income,
+    prior_year.operating_income as prior_operating_income,
+    case
+        when prior_year.operating_income > 0
+            then {{ safe_divide(
+                'current_year.operating_income - prior_year.operating_income',
+                'prior_year.operating_income'
+            ) }}
+    end as operating_income_growth_rate,
+
+    current_year.net_income,
+    prior_year.net_income as prior_net_income,
+    case
+        when prior_year.net_income > 0
+            then {{ safe_divide('current_year.net_income - prior_year.net_income', 'prior_year.net_income') }}
+    end as net_income_growth_rate,
+
+    current_year.operating_cash_flow,
+    prior_year.operating_cash_flow as prior_operating_cash_flow,
+    case
+        when prior_year.operating_cash_flow > 0
+            then {{ safe_divide(
+                'current_year.operating_cash_flow - prior_year.operating_cash_flow',
+                'prior_year.operating_cash_flow'
+            ) }}
+    end as operating_cash_flow_growth_rate,
+
+    current_year.total_assets,
+    prior_year.total_assets as prior_total_assets,
+    case
+        when prior_year.total_assets > 0
+            then {{ safe_divide('current_year.total_assets - prior_year.total_assets', 'prior_year.total_assets') }}
+    end as total_assets_growth_rate
+
+from annual as current_year
+left join annual as prior_year
+    on
+        current_year.cik = prior_year.cik
+        and prior_year.fiscal_year = current_year.fiscal_year - 1
diff --git a/models/marts/finance/mart_data_quality_summary.sql b/models/marts/finance/mart_data_quality_summary.sql
new file mode 100644
index 0000000..3484fc8
--- /dev/null
+++ b/models/marts/finance/mart_data_quality_summary.sql
@@ -0,0 +1,33 @@
+/*
+    Data coverage by fiscal year, for deciding whether a year is usable.
+
+    Grain: one row per fiscal_year.
+
+    Exists because "the pipeline ran successfully" and "the data is usable" are
+    different claims. A year is analysis-ready when at least
+    var('analysis_ready_min_coverage') of its annual reports have revenue and a
+    balance sheet. Check is_analysis_ready before cross-company analysis.
+*/
+
+with annual as (
+
+    select * from {{ ref('fct_company_financials_annual') }}
+
+)
+
+select
+    fiscal_year,
+    count(*) as annual_report_count,
+    sum(case when is_from_amendment then 1 else 0 end) as amended_report_count,
+    avg(case when has_revenue then 1.0 else 0.0 end) as revenue_coverage,
+    avg(case when has_balance_sheet then 1.0 else 0.0 end) as balance_sheet_coverage,
+    avg(case when has_cash_flow then 1.0 else 0.0 end) as cash_flow_coverage,
+    sum(case when balance_sheet_balances is not null then 1 else 0 end)
+        as balance_sheet_checkable_count,
+    sum(case when balance_sheet_balances = false then 1 else 0 end)
+        as unbalanced_balance_sheet_count,
+    avg(case when has_revenue then 1.0 else 0.0 end) >= {{ var('analysis_ready_min_coverage') }}
+    and avg(case when has_balance_sheet then 1.0 else 0.0 end) >= {{ var('analysis_ready_min_coverage') }}
+        as is_analysis_ready
+from annual
+group by fiscal_year
diff --git a/models/marts/finance/mart_restatements.sql b/models/marts/finance/mart_restatements.sql
new file mode 100644
index 0000000..d4f56a0
--- /dev/null
+++ b/models/marts/finance/mart_restatements.sql
@@ -0,0 +1,154 @@
+/*
+    Restatements: every amendment that re-filed financial statements, compared
+    with the original filing for the same company and period.
+
+    Grain: one row per amending filing.
+
+    This model deliberately reads ALL filings, bypassing
+    int_filings__deduplicated -- that model's job is to hide superseded
+    filings, and this one's job is to look at them. Amendments with no
+    financial statements (e.g. Part III amendments) are not restatements and
+    are excluded.
+
+    A restatement is flagged material when revenue or net income moves by more
+    than var('materiality_threshold') of the original. 5% is the common rule of
+    thumb; SEC Staff Accounting Bulletin 99 cautions it is a starting point for
+    judgement, not a bright line.
+
+    Change rates divide by the ABSOLUTE original value, so a loss that grows
+    shows as a negative change.
+*/
+
+with statement_filings as (
+
+    select distinct filing_id
+    from {{ ref('stg_sec__presentation') }}
+    where
+        statement_code in {{ primary_statement_codes() }}
+        and not is_parenthetical
+
+),
+
+filings as (
+
+    select
+        submissions.filing_id,
+        submissions.company_id,
+        submissions.period_end_date,
+        submissions.base_form_type,
+        submissions.form_type,
+        submissions.fiscal_year,
+        submissions.fiscal_period,
+        submissions.filed_date,
+        row_number() over (
+            partition by
+                submissions.company_id,
+                submissions.period_end_date,
+                submissions.base_form_type
+            order by
+                submissions.filed_date asc,
+                submissions.accepted_at asc,
+                submissions.filing_id asc
+        ) as filing_sequence
+    from {{ ref('stg_sec__submissions') }} as submissions
+    inner join statement_filings
+        on submissions.filing_id = statement_filings.filing_id
+    where submissions.base_form_type in ('10-K', '10-Q')
+
+),
+
+filing_values as (
+
+    select
+        filings.*,
+        income.revenue,
+        income.net_income,
+        balance.total_assets,
+        balance.total_equity
+    from filings
+    left join {{ ref('int_facts__income_statement') }} as income
+        on
+            filings.filing_id = income.filing_id
+            -- compare like with like: the full year for a 10-K, the quarter for a 10-Q
+            and income.duration_quarters = case when filings.base_form_type = '10-K' then 4 else 1 end
+    left join {{ ref('int_facts__balance_sheet') }} as balance
+        on filings.filing_id = balance.filing_id
+
+),
+
+compared as (
+
+    select
+        amended.company_id,
+        amended.base_form_type,
+        amended.fiscal_year,
+        amended.fiscal_period,
+        amended.period_end_date,
+        original.filing_id as original_filing_id,
+        amended.filing_id as amended_filing_id,
+        amended.form_type as amended_form_type,
+        original.filed_date as original_filed_date,
+        amended.filed_date as amended_filed_date,
+
+        original.revenue as original_revenue,
+        amended.revenue as restated_revenue,
+        amended.revenue - original.revenue as revenue_change,
+        {{ safe_divide('amended.revenue - original.revenue', 'abs(original.revenue)') }}
+            as revenue_change_rate,
+
+        original.net_income as original_net_income,
+        amended.net_income as restated_net_income,
+        amended.net_income - original.net_income as net_income_change,
+        {{ safe_divide('amended.net_income - original.net_income', 'abs(original.net_income)') }}
+            as net_income_change_rate,
+
+        original.total_assets as original_total_assets,
+        amended.total_assets as restated_total_assets,
+        original.total_equity as original_total_equity,
+        amended.total_equity as restated_total_equity
+
+    from filing_values as amended
+    inner join filing_values as original
+        on
+            amended.company_id = original.company_id
+            and amended.period_end_date = original.period_end_date
+            and amended.base_form_type = original.base_form_type
+            and original.filing_sequence = 1
+    where amended.filing_sequence > 1
+
+)
+
+select
+    {{ dbt_utils.generate_surrogate_key(['compared.amended_filing_id']) }} as restatement_key,
+    {{ dbt_utils.generate_surrogate_key(['compared.company_id']) }} as company_key,
+    compared.company_id as cik,
+    companies.company_name,
+    compared.base_form_type,
+    compared.fiscal_year,
+    compared.fiscal_period,
+    compared.period_end_date,
+    compared.original_filing_id,
+    compared.amended_filing_id,
+    compared.amended_form_type,
+    compared.original_filed_date,
+    compared.amended_filed_date,
+    {{ dbt.datediff('compared.original_filed_date', 'compared.amended_filed_date', 'day') }}
+        as days_until_restatement,
+    compared.original_revenue,
+    compared.restated_revenue,
+    compared.revenue_change,
+    compared.revenue_change_rate,
+    compared.original_net_income,
+    compared.restated_net_income,
+    compared.net_income_change,
+    compared.net_income_change_rate,
+    compared.original_total_assets,
+    compared.restated_total_assets,
+    compared.original_total_equity,
+    compared.restated_total_equity,
+    coalesce(abs(compared.revenue_change_rate) > {{ var('materiality_threshold') }}, false)
+    or coalesce(abs(compared.net_income_change_rate) > {{ var('materiality_threshold') }}, false)
+        as is_material_restatement
+from compared
+left join {{ ref('dim_company') }} as companies
+    on compared.company_id = companies.cik
diff --git a/models/marts/finance/mart_sector_benchmarks.sql b/models/marts/finance/mart_sector_benchmarks.sql
new file mode 100644
index 0000000..a308e67
--- /dev/null
+++ b/models/marts/finance/mart_sector_benchmarks.sql
@@ -0,0 +1,64 @@
+/*
+    Sector benchmarks: the median and interquartile range of key ratios for
+    each sector and fiscal year.
+
+    Grain: one row per (sector, fiscal_year).
+
+    Medians, not means: financial ratios are heavily right-skewed, and one
+    company with a near-zero equity base drags a mean somewhere useless. An
+    analyst asking "is a 22% operating margin good for software?" wants the
+    median and the 25th-75th percentile range.
+
+    Sector-years with fewer than var('min_companies_per_benchmark') companies
+    are excluded entirely: a "median" over three companies is not a benchmark,
+    and publishing it invites misuse.
+
+    Percentiles use percentile_cont (linear interpolation); NULL ratios are
+    ignored, so each metric's percentiles may cover fewer companies than
+    company_count.
+*/
+
+{% set metrics = [
+    'gross_margin', 'operating_margin', 'net_margin', 'return_on_equity',
+    'current_ratio', 'debt_to_equity'
+] %}
+
+with ratios as (
+
+    select * from {{ ref('fct_financial_ratios') }}
+
+),
+
+eligible as (
+
+    select
+        sector,
+        fiscal_year,
+        count(distinct cik) as company_count
+    from ratios
+    group by sector, fiscal_year
+    having count(distinct cik) >= {{ var('min_companies_per_benchmark') }}
+
+)
+
+select
+    {{ dbt_utils.generate_surrogate_key(['ratios.sector', 'ratios.fiscal_year']) }}
+        as sector_benchmark_key,
+    ratios.sector,
+    ratios.fiscal_year,
+    eligible.company_count,
+    {% for metric in metrics %}
+    median(ratios.{{ metric }}) as median_{{ metric }},
+    percentile_cont(0.25) within group (order by ratios.{{ metric }}) as p25_{{ metric }},
+    percentile_cont(0.75) within group (order by ratios.{{ metric }}) as p75_{{ metric }},
+    {% endfor %}
+    median(ratios.revenue) as median_revenue
+from ratios
+inner join eligible
+    on
+        ratios.sector = eligible.sector
+        and ratios.fiscal_year = eligible.fiscal_year
+group by
+    ratios.sector,
+    ratios.fiscal_year,
+    eligible.company_count
diff --git a/models/staging/sec/_sec__models.yml b/models/staging/sec/_sec__models.yml
new file mode 100644
index 0000000..718d7a4
--- /dev/null
+++ b/models/staging/sec/_sec__models.yml
@@ -0,0 +1,280 @@
+version: 2
+
+models:
+  - name: stg_sec__submissions
+    description: >
+      One row per SEC submission (filing), renamed and typed. Includes every
+      form type and every amendment; nothing is filtered here.
+    columns:
+      - name: filing_id
+        description: SEC accession number (adsh). Natural key of a filing.
+        data_type: varchar
+        data_tests: [not_null, unique]
+      - name: company_id
+        description: Central Index Key (CIK) of the registrant. Natural key of a company.
+        data_type: bigint
+        data_tests: [not_null]
+      - name: company_name
+        description: Registrant's conformed name as of the filing date.
+        data_type: varchar
+      - name: sic_code
+        description: Four-digit Standard Industrial Classification code as of the filing date. Nullable.
+        data_type: integer
+      - name: business_country_code
+        description: Country of the business address (ISO 3166-1).
+        data_type: varchar
+      - name: business_state_code
+        description: State or province of the business address (US/CA only).
+        data_type: varchar
+      - name: business_city
+        description: City of the business address.
+        data_type: varchar
+      - name: incorporation_country_code
+        description: Country of incorporation.
+        data_type: varchar
+      - name: incorporation_state_code
+        description: State or province of incorporation (US/CA only).
+        data_type: varchar
+      - name: former_company_name
+        description: Most recent former name, if the registrant has changed its name.
+        data_type: varchar
+      - name: name_changed_date
+        description: Date of the change from the former name.
+        data_type: date
+      - name: filer_status_code
+        description: Filer status, e.g. 1-LAF (large accelerated) ... 5-SML (smaller reporting).
+        data_type: varchar
+      - name: is_well_known_seasoned_issuer
+        description: True if the filer is a Well Known Seasoned Issuer.
+        data_type: boolean
+      - name: fiscal_year_end_mmdd
+        description: Fiscal year end as MMDD, e.g. 1231 or 0630.
+        data_type: varchar
+      - name: form_type
+        description: Submission type, e.g. 10-K, 10-Q, 10-K/A, 20-F.
+        data_type: varchar
+        data_tests: [not_null]
+      - name: base_form_type
+        description: Form type with any /A amendment suffix removed (10-K/A -> 10-K).
+        data_type: varchar
+      - name: is_amendment
+        description: True if the form type ends in /A.
+        data_type: boolean
+      - name: period_end_date
+        description: Balance sheet date of the reporting period (parsed from YYYYMMDD).
+        data_type: date
+        data_tests: [not_null]
+      - name: fiscal_year
+        description: Fiscal year focus as reported by the filer.
+        data_type: integer
+      - name: fiscal_period
+        description: Fiscal period focus (FY, Q1, Q2, Q3, Q4).
+        data_type: varchar
+        data_tests:
+          - accepted_values:
+              arguments:
+                values: ["FY", "Q1", "Q2", "Q3", "Q4"]
+              config:
+                severity: warn
+      - name: filed_date
+        description: Date the filing was filed with the SEC.
+        data_type: date
+        data_tests:
+          - not_null
+          - dbt_utils.expression_is_true:
+              arguments:
+                # A filing submitted before its period ended means a date
+                # parsing bug -- or, rarely, a filer error, hence the threshold.
+                expression: ">= period_end_date"
+              config:
+                warn_if: ">0"
+                error_if: ">100"
+      - name: accepted_at
+        description: EDGAR acceptance timestamp (US Eastern time, no offset in the source).
+        data_type: timestamp
+      - name: is_subsequently_amended
+        description: SEC 'prevrpt' flag. True if the filing was amended before the data set's cut-off.
+        data_type: boolean
+      - name: has_detailed_tagging
+        description: True if footnotes and schedules are tagged at the detailed level.
+        data_type: boolean
+      - name: xbrl_instance_name
+        description: File name of the XBRL instance document.
+        data_type: varchar
+      - name: registrant_count
+        description: Number of CIKs included in the submission (co-registrants).
+        data_type: integer
+      - name: additional_ciks
+        description: Space-delimited CIKs of co-registrants, if any.
+        data_type: varchar
+      - name: source_quarter
+        description: SEC data set quarter the row was loaded from, e.g. 2024q1.
+        data_type: varchar
+      - name: loaded_at
+        description: When the loader wrote the row.
+        data_type: timestamp
+
+  - name: stg_sec__numeric_facts
+    description: >
+      One row per numeric XBRL fact, at the SEC's eight-column grain. Includes
+      every filing, every tag (standard and custom), comparatives, segment rows
+      and co-registrant rows. Downstream models decide what to keep.
+    columns:
+      - name: fact_key
+        description: >
+          Hash of the eight grain columns (adsh, tag, version, ddate, qtrs, uom,
+          segments, coreg). Its uniqueness test IS the grain test.
+        data_type: varchar
+        data_tests: [not_null, unique]
+      - name: filing_id
+        description: Accession number of the filing that reported the fact.
+        data_type: varchar
+        data_tests:
+          - not_null
+          - relationships:
+              arguments:
+                to: ref('stg_sec__submissions')
+                field: filing_id
+      - name: tag
+        description: XBRL element name, e.g. NetIncomeLoss.
+        data_type: varchar
+        data_tests: [not_null]
+      - name: tag_version
+        description: Taxonomy version (e.g. us-gaap/2023), or the accession number for custom tags.
+        data_type: varchar
+      - name: period_end_date
+        description: End date of the value, rounded by the SEC to the nearest month end.
+        data_type: date
+        data_tests: [not_null]
+      - name: duration_quarters
+        description: Quarters the value covers. 0 = point in time (balance sheet), 1 = one quarter, 4 = one year; 2-3 = year to date.
+        data_type: integer
+        data_tests: [not_null]
+      - name: unit_of_measure
+        description: Unit, e.g. USD or USD/shares.
+        data_type: varchar
+      - name: segments
+        description: Axis/member dimensions. NULL means no breakdown (the consolidated figure).
+        data_type: varchar
+      - name: coregistrant
+        description: Co-registrant or related entity. NULL means the consolidated registrant.
+        data_type: varchar
+      - name: is_consolidated
+        description: True when the fact has neither segments nor a co-registrant.
+        data_type: boolean
+      - name: fact_value
+        description: Value as a decimal. NULL when the source value is empty (nil) or unparseable.
+        data_type: decimal(28,4)
+      - name: fact_value_raw
+        description: Value exactly as published, kept to diagnose parse failures.
+        data_type: varchar
+      - name: footnote
+        description: Footnote text attached to the value, if any.
+        data_type: varchar
+      - name: source_quarter
+        description: SEC data set quarter the row was loaded from.
+        data_type: varchar
+      - name: loaded_at
+        description: When the loader wrote the row. The incremental watermark for fct_financial_facts.
+        data_type: timestamp
+
+  - name: stg_sec__tags
+    description: >
+      One row per XBRL tag and taxonomy version. Deduplicated across quarterly
+      files (the SEC repeats standard tags in every quarter).
+    data_tests:
+      - dbt_utils.unique_combination_of_columns:
+          arguments:
+            combination_of_columns: ["tag", "tag_version"]
+    columns:
+      - name: tag
+        description: XBRL element name.
+        data_type: varchar
+        data_tests: [not_null]
+      - name: tag_version
+        description: Taxonomy version, or the accession number for custom tags.
+        data_type: varchar
+        data_tests: [not_null]
+      - name: is_custom
+        description: True for a filer-defined (custom) tag.
+        data_type: boolean
+      - name: is_abstract
+        description: True for a grouping header that never carries a value.
+        data_type: boolean
+      - name: data_type
+        description: XBRL data type, e.g. monetary or perShare.
+        data_type: varchar
+      - name: instant_or_duration
+        description: I = point in time, D = duration.
+        data_type: varchar
+      - name: natural_balance
+        description: C (credit) or D (debit) for monetary tags.
+        data_type: varchar
+      - name: tag_label
+        description: Standard label of the tag.
+        data_type: varchar
+      - name: tag_documentation
+        description: Definition of the tag.
+        data_type: varchar
+      - name: source_quarter
+        description: Quarter the retained copy of the tag came from.
+        data_type: varchar
+      - name: loaded_at
+        description: When the retained copy was loaded.
+        data_type: timestamp
+
+  - name: stg_sec__presentation
+    description: One row per rendered statement line (filing, report, line).
+    data_tests:
+      - dbt_utils.unique_combination_of_columns:
+          arguments:
+            combination_of_columns: ["filing_id", "report_number", "line_number"]
+    columns:
+      - name: filing_id
+        description: Accession number.
+        data_type: varchar
+        data_tests:
+          - not_null
+          - relationships:
+              arguments:
+                to: ref('stg_sec__submissions')
+                field: filing_id
+      - name: report_number
+        description: Report (statement) number within the filing.
+        data_type: integer
+      - name: line_number
+        description: Line order within the report.
+        data_type: integer
+      - name: statement_code
+        description: BS, IS, CF, EQ, CI, SI (schedule of investments), UN (unclassifiable) or CP (cover page).
+        data_type: varchar
+        data_tests:
+          - accepted_values:
+              arguments:
+                values: ["BS", "IS", "CF", "EQ", "CI", "SI", "UN", "CP"]
+              config:
+                severity: warn
+      - name: is_parenthetical
+        description: True for a parenthetical line, e.g. "net of allowance of $1m". Not a line item.
+        data_type: boolean
+      - name: rendered_file_type
+        description: H = rendered from .htm, X = from .xml.
+        data_type: varchar
+      - name: tag
+        description: Tag presented on the line.
+        data_type: varchar
+      - name: tag_version
+        description: Taxonomy version of the tag.
+        data_type: varchar
+      - name: presented_label
+        description: Label shown on the statement line.
+        data_type: varchar
+      - name: is_negated
+        description: True if the line displays the value with its sign flipped.
+        data_type: boolean
+      - name: source_quarter
+        description: Quarter the row was loaded from.
+        data_type: varchar
+      - name: loaded_at
+        description: When the row was loaded.
+        data_type: timestamp
