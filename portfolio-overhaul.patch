@@ -0,0 +1,35 @@
+/*
+    One row per line of each rendered financial statement: where (which
+    statement, which line) a filer presented each tag.
+
+    This is what tells us a tag is on the income statement rather than in a
+    footnote -- the tag name alone does not.
+*/
+
+with source as (
+
+    select * from {{ source('sec', 'pre') }}
+
+),
+
+renamed as (
+
+    select
+        adsh as filing_id,
+        try_cast(report as integer) as report_number,
+        try_cast(line as integer) as line_number,
+        stmt as statement_code,
+        inpth = '1' as is_parenthetical,
+        rfile as rendered_file_type,
+        tag,
+        version as tag_version,
+        plabel as presented_label,
+        negating = '1' as is_negated,
+        _source_quarter as source_quarter,
+        _loaded_at as loaded_at
+
+    from source
+
+)
+
+select * from renamed
diff --git a/models/staging/sec/stg_sec__submissions.sql b/models/staging/sec/stg_sec__submissions.sql
new file mode 100644
index 0000000..2cbf6d0
--- /dev/null
+++ b/models/staging/sec/stg_sec__submissions.sql
@@ -0,0 +1,54 @@
+/*
+    One row per SEC submission (filing). Renamed and typed; no filtering, joins
+    or business logic.
+
+    Dates arrive as YYYYMMDD strings and timestamps as text; every cast is a
+    "try" cast so one malformed value becomes NULL (and fails a test) rather than
+    failing the whole build.
+*/
+
+with source as (
+
+    select * from {{ source('sec', 'sub') }}
+
+),
+
+renamed as (
+
+    select
+        adsh as filing_id,
+        try_cast(cik as bigint) as company_id,
+        trim(name) as company_name,
+        try_cast(sic as integer) as sic_code,
+        countryba as business_country_code,
+        stprba as business_state_code,
+        cityba as business_city,
+        countryinc as incorporation_country_code,
+        stprinc as incorporation_state_code,
+        former as former_company_name,
+        {{ parse_yyyymmdd('changed') }} as name_changed_date,
+        afs as filer_status_code,
+        wksi = '1' as is_well_known_seasoned_issuer,
+        fye as fiscal_year_end_mmdd,
+        form as form_type,
+        replace(form, '/A', '') as base_form_type,
+        form like '%/A' as is_amendment,
+        {{ parse_yyyymmdd('period') }} as period_end_date,
+        try_cast(fy as integer) as fiscal_year,
+        fp as fiscal_period,
+        {{ parse_yyyymmdd('filed') }} as filed_date,
+        -- EDGAR acceptance time, US Eastern, published without a zone offset.
+        try_cast(accepted as timestamp) as accepted_at,
+        prevrpt = '1' as is_subsequently_amended,
+        detail = '1' as has_detailed_tagging,
+        instance as xbrl_instance_name,
+        try_cast(nciks as integer) as registrant_count,
+        aciks as additional_ciks,
+        _source_quarter as source_quarter,
+        _loaded_at as loaded_at
+
+    from source
+
+)
+
+select * from renamed
diff --git a/models/staging/sec/stg_sec__tags.sql b/models/staging/sec/stg_sec__tags.sql
new file mode 100644
index 0000000..a540bb5
--- /dev/null
+++ b/models/staging/sec/stg_sec__tags.sql
@@ -0,0 +1,40 @@
+/*
+    One row per XBRL tag per taxonomy version.
+
+    The single exception to "staging does not deduplicate": the SEC republishes
+    every standard tag it uses in EACH quarterly tag.txt, so the raw table holds
+    the same (tag, version) once per loaded quarter. That is a property of the
+    file format, not of the data, so it is collapsed here -- keeping the most
+    recently loaded copy -- and every consumer can rely on a unique key.
+*/
+
+with source as (
+
+    select * from {{ source('sec', 'tag') }}
+
+),
+
+renamed as (
+
+    select
+        tag,
+        version as tag_version,
+        custom = '1' as is_custom,
+        abstract = '1' as is_abstract,
+        datatype as data_type,
+        iord as instant_or_duration,
+        crdr as natural_balance,
+        tlabel as tag_label,
+        doc as tag_documentation,
+        _source_quarter as source_quarter,
+        _loaded_at as loaded_at
+
+    from source
+
+)
+
+select * from renamed
+qualify row_number() over (
+    partition by tag, tag_version
+    order by loaded_at desc, source_quarter desc
+) = 1
diff --git a/orchestration/airflow/dags/sec_financials_pipeline.py b/orchestration/airflow/dags/sec_financials_pipeline.py
new file mode 100644
index 0000000..4a0daaf
--- /dev/null
+++ b/orchestration/airflow/dags/sec_financials_pipeline.py
@@ -0,0 +1,130 @@
+"""Scheduled SEC ingest and dbt transformation (Airflow 3 reference DAG).
+
+STATUS: reference orchestration. Import-tested against Apache Airflow 3.3
+(python_tests/test_airflow_dag.py); not deployed anywhere as part of this
+project. See docs/ARCHITECTURE.md > Orchestration.
+
+Schedule: weekly. The SEC posts each quarterly file shortly after the quarter
+closes but commits to no date. A run that finds nothing new costs one HTTP
+request and exits as "skipped", so polling weekly is cheap and bounds staleness
+at about a week -- a monthly poll could leave a published quarter unloaded for
+a month.
+
+Task shape:
+
+    load_latest_quarter          exit 99 -> skipped (not published yet, or already
+            |                    loaded); downstream tasks are then skipped too
+    dbt_transform:
+        dbt_seed -> dbt_build_staging -> dbt_build_intermediate -> dbt_build_marts
+            |
+    dbt_docs_generate
+    dbt_source_freshness         runs even when the load was skipped: it is what
+                                 notices a quarter that never arrived
+
+`dbt build` already runs each model's tests before its children and skips the
+children of a failing test. Splitting the build by layer adds visibility in the
+Airflow UI and lets a failed layer be retried on its own.
+
+Deployment assumptions (all overridable):
+* this repository is checked out at $SEC_ANALYTICS_PROJECT_DIR on the workers,
+  with requirements.txt installed and `dbt deps` run;
+* Airflow Variables hold the Snowflake account, user and key path and the SEC
+  User-Agent. They are read through Jinja templates at RUN time -- never at
+  import time, which would query the metadata database on every DAG parse.
+"""
+
+from __future__ import annotations
+
+import os
+from datetime import timedelta
+
+import pendulum
+from airflow.providers.standard.operators.bash import BashOperator
+from airflow.providers.standard.operators.empty import EmptyOperator
+from airflow.sdk import DAG, TaskGroup
+
+PROJECT_DIR = os.environ.get("SEC_ANALYTICS_PROJECT_DIR", "/opt/airflow/sec-analytics")
+
+SNOWFLAKE_ENV = {
+    "DBT_PROFILES_DIR": f"{PROJECT_DIR}/profiles",
+    "DBT_TARGET": "{{ var.value.get('sec_dbt_target', 'dev') }}",
+    "DBT_SNOWFLAKE_SCHEMA": "{{ var.value.get('sec_dbt_schema', 'analytics') }}",
+    "SNOWFLAKE_ACCOUNT": "{{ var.value.snowflake_account }}",
+    "SNOWFLAKE_USER": "{{ var.value.snowflake_user }}",
+    "SNOWFLAKE_PRIVATE_KEY_PATH": "{{ var.value.snowflake_private_key_path }}",
+}
+
+DEFAULT_ARGS = {
+    "owner": "analytics-engineering",
+    "depends_on_past": False,
+    "retries": 1,
+    "retry_delay": timedelta(minutes=10),
+    "retry_exponential_backoff": True,
+}
+
+
+def dbt_task(task_id: str, command: str, **kwargs) -> BashOperator:
+    """BashOperator running one dbt command from the project directory."""
+    return BashOperator(
+        task_id=task_id,
+        bash_command=f"cd {PROJECT_DIR} && dbt {command}",
+        env=SNOWFLAKE_ENV,
+        append_env=True,
+        **kwargs,
+    )
+
+
+with DAG(
+    dag_id="sec_financials_pipeline",
+    description="Load the latest SEC Financial Statement Data Set and build the dbt models",
+    start_date=pendulum.datetime(2024, 1, 1, tz="UTC"),
+    schedule="0 6 * * 1",  # Mondays 06:00 UTC
+    catchup=False,
+    max_active_runs=1,
+    default_args=DEFAULT_ARGS,
+    tags=["sec", "dbt", "snowflake"],
+    doc_md=__doc__,
+) as dag:
+    start = EmptyOperator(task_id="start")
+
+    # The loader resolves the latest completed quarter itself, downloads it,
+    # validates the files and loads them in one transaction. It exits 99 when
+    # the quarter is not published yet (HTTP 404) or is already loaded --
+    # BashOperator's default skip_on_exit_code, so the task shows as skipped,
+    # not failed. Any other failure (403, bad file layout, row-count mismatch)
+    # fails the task.
+    load_latest_quarter = BashOperator(
+        task_id="load_latest_quarter",
+        bash_command=(
+            f"cd {PROJECT_DIR} && python -m ingestion.load_sec_data "
+            "--target snowflake --source sec --quarters latest --skip-if-loaded"
+        ),
+        env={
+            **SNOWFLAKE_ENV,
+            "SNOWFLAKE_LOADER_ROLE": "SEC_LOADER",
+            "SEC_USER_AGENT": "{{ var.value.sec_user_agent }}",
+        },
+        append_env=True,
+        skip_on_exit_code=99,
+        execution_timeout=timedelta(hours=1),
+    )
+
+    with TaskGroup(group_id="dbt_transform") as dbt_transform:
+        seed = dbt_task("dbt_seed", "deps && dbt seed")
+        build_staging = dbt_task("dbt_build_staging", "build --select staging")
+        build_intermediate = dbt_task("dbt_build_intermediate", "build --select intermediate")
+        build_marts = dbt_task("dbt_build_marts", "build --select marts")
+        seed >> build_staging >> build_intermediate >> build_marts
+
+    generate_docs = dbt_task("dbt_docs_generate", "docs generate")
+
+    # Freshness is a monitor, not a gate: it runs whatever happened upstream,
+    # and warns when no quarter has been loaded for 100+ days.
+    source_freshness = dbt_task(
+        "dbt_source_freshness", "source freshness", trigger_rule="all_done", retries=0
+    )
+
+    end = EmptyOperator(task_id="end", trigger_rule="none_failed")
+
+    start >> load_latest_quarter >> dbt_transform >> generate_docs >> end
+    load_latest_quarter >> source_freshness >> end
