+                to: ref('fct_company_financials_annual')
+                field: annual_financials_key
+      - name: company_key
+        description: Key in dim_company.
+        data_type: varchar
+      - name: cik
+        description: SEC Central Index Key.
+        data_type: bigint
+      - name: company_name
+        description: Current company name.
+        data_type: varchar
+      - name: sector
+        description: SIC division as of the filing.
+        data_type: varchar
+      - name: industry_group
+        description: SIC major group as of the filing.
+        data_type: varchar
+      - name: fiscal_year
+        description: Fiscal year.
+        data_type: integer
+      - name: fiscal_year_end_date
+        description: Fiscal year end date.
+        data_type: date
+      - name: gross_margin
+        description: Gross profit / revenue.
+        data_type: double
