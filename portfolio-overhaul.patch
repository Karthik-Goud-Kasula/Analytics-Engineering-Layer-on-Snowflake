+"""File layouts of the SEC Financial Statement Data Sets, and header validation.
+
+Source of truth: https://www.sec.gov/files/financial-statement-data-sets.pdf
+Each quarterly zip holds four tab-delimited, UTF-8 text files with a lowercase
+header row: sub.txt, num.txt, tag.txt and pre.txt.
+
+The raw tables mirror these files column-for-column, all VARCHAR. Nothing is cast
+at load time, so a malformed value can never make the load drop a row; typing and
+validation happen in the dbt staging layer, where they are tested.
+
+Columns are mapped by header NAME, not position. Two columns are optional because
+older copies of the files do not have them:
+
+* num.segments was added when the SEC reprocessed the data sets in December 2024.
+* pre.negating does not appear in older documentation of the layout.
+
+A file missing an optional column loads with NULLs in it. A file with an unknown
+column, or missing a required one, is rejected: silently loading a changed layout
+into the wrong columns is far worse than a failed load.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import Path
+
+
+@dataclass(frozen=True)
+class FileLayout:
+    """Expected columns of one SEC file and the raw table it loads into."""
+
+    file_name: str
+    table_name: str
+    columns: tuple[str, ...]
+    optional_columns: frozenset[str] = frozenset()
+
+    @property
+    def required_columns(self) -> tuple[str, ...]:
+        return tuple(c for c in self.columns if c not in self.optional_columns)
+
+
+# Metadata columns the loader appends to every raw table.
+METADATA_COLUMNS: tuple[str, ...] = ("_source_quarter", "_source_file", "_loaded_at")
+
+SUB = FileLayout(
+    file_name="sub.txt",
+    table_name="sub",
+    columns=(
+        "adsh", "cik", "name", "sic", "countryba", "stprba", "cityba", "zipba",
+        "bas1", "bas2", "baph", "countryma", "stprma", "cityma", "zipma", "mas1",
+        "mas2", "countryinc", "stprinc", "ein", "former", "changed", "afs", "wksi",
+        "fye", "form", "period", "fy", "fp", "filed", "accepted", "prevrpt",
+        "detail", "instance", "nciks", "aciks",
+    ),
+)  # fmt: skip
+
+NUM = FileLayout(
+    file_name="num.txt",
+    table_name="num",
+    columns=(
+        "adsh", "tag", "version", "ddate", "qtrs", "uom", "segments", "coreg",
+        "value", "footnote",
+    ),
+    optional_columns=frozenset({"segments"}),
+)  # fmt: skip
+
+TAG = FileLayout(
+    file_name="tag.txt",
+    table_name="tag",
+    columns=(
+        "tag", "version", "custom", "abstract", "datatype", "iord", "crdr",
+        "tlabel", "doc",
+    ),
+)  # fmt: skip
+
+PRE = FileLayout(
+    file_name="pre.txt",
+    table_name="pre",
+    columns=(
+        "adsh", "report", "line", "stmt", "inpth", "rfile", "tag", "version",
+        "plabel", "negating",
+    ),
+    optional_columns=frozenset({"negating"}),
+)  # fmt: skip
+
+LAYOUTS: tuple[FileLayout, ...] = (SUB, NUM, TAG, PRE)
+
+DELIMITER = "\t"
+ENCODING = "utf-8"
+
+
+class LayoutError(ValueError):
+    """A source file does not match the documented SEC layout."""
+
+
+def read_header(path: Path) -> list[str]:
+    """Return the header row of a tab-delimited SEC file."""
+    with path.open("r", encoding=ENCODING, newline="") as handle:
+        first_line = handle.readline()
+    if not first_line:
+        raise LayoutError(f"{path}: file is empty (expected a header row)")
+    return first_line.rstrip("\r\n").split(DELIMITER)
+
+
+def column_positions(layout: FileLayout, header: list[str], path: Path) -> dict[str, int | None]:
+    """Map each canonical column to its 1-based position in the file (None = absent).
+
+    Raises LayoutError with an actionable message when the header does not match.
+    """
+    normalized = [h.strip().lower() for h in header]
+
+    duplicates = sorted({h for h in normalized if normalized.count(h) > 1})
+    if duplicates:
+        raise LayoutError(f"{path}: duplicate columns in header: {duplicates}")
+
+    unknown = [h for h in normalized if h not in layout.columns]
+    missing = [c for c in layout.required_columns if c not in normalized]
+    if unknown or missing:
+        raise LayoutError(
+            f"{path}: header does not match the SEC {layout.file_name} layout. "
+            f"Unknown columns: {unknown or 'none'}. Missing required columns: "
+            f"{missing or 'none'}. If the SEC changed the format, update "
+            "ingestion/sec_layout.py and snowflake/setup/02_raw_tables.sql together."
+        )
+
+    return {
+        column: (normalized.index(column) + 1 if column in normalized else None) for column in layout.columns
+    }
+
+
+def count_and_check_rows(path: Path, expected_fields: int) -> int:
+    """Count data rows, failing on any row whose field count differs from the header.
+
+    A field count mismatch means an embedded tab or newline, i.e. the file would
+    load shifted values into the wrong columns. The count is also used afterwards
+    to reconcile the number of rows the warehouse reports as loaded.
+    """
+    rows = 0
+    with path.open("r", encoding=ENCODING, newline="") as handle:
+        handle.readline()  # header
+        for line_number, line in enumerate(handle, start=2):
+            if line in ("\n", "\r\n", ""):
+                continue
+            fields = line.rstrip("\r\n").count(DELIMITER) + 1
+            if fields != expected_fields:
+                raise LayoutError(
+                    f"{path}:{line_number}: expected {expected_fields} tab-separated fields, found {fields}"
+                )
+            rows += 1
+    return rows
diff --git a/ingestion/sources.py b/ingestion/sources.py
new file mode 100644
index 0000000..93fae28
--- /dev/null
+++ b/ingestion/sources.py
@@ -0,0 +1,113 @@
+"""Where quarterly SEC files come from: the bundled synthetic sample, or sec.gov."""
+
+from __future__ import annotations
+
+import logging
+import shutil
+import time
+import zipfile
+from pathlib import Path
+from urllib.error import HTTPError, URLError
+from urllib.request import Request, urlopen
+
+from ingestion.quarters import parse_quarter
+from ingestion.sec_layout import LAYOUTS
+
+LOG = logging.getLogger(__name__)
+
+SEC_URL_TEMPLATE = "https://www.sec.gov/files/dera/data/financial-statement-data-sets/{quarter}.zip"
+RETRYABLE_STATUS = {429, 500, 502, 503, 504}
+
+
+class QuarterNotPublished(Exception):
+    """The SEC has not published this quarter yet (HTTP 404). Expected, not an error."""
+
+
+def sample_quarters(sample_root: Path) -> list[str]:
+    """Quarters available in the bundled sample data, oldest first."""
+    found = []
+    for child in sample_root.iterdir() if sample_root.exists() else []:
+        if not child.is_dir():
+            continue
+        try:
+            parse_quarter(child.name)
+        except ValueError:
+            continue
+        found.append(child.name)
+    return sorted(found, key=parse_quarter)
+
+
+def sample_quarter_dir(sample_root: Path, quarter: str) -> Path:
+    directory = sample_root / quarter
+    if not directory.is_dir():
+        available = ", ".join(sample_quarters(sample_root)) or "none"
+        raise FileNotFoundError(f"no sample data for {quarter} in {sample_root} (available: {available})")
+    return directory
+
+
+def download_quarter(
+    quarter: str,
+    download_root: Path,
+    user_agent: str,
+    *,
+    timeout: int = 120,
+    retries: int = 3,
+    backoff_seconds: float = 5.0,
+) -> Path:
+    """Download and extract one quarterly zip from sec.gov. Returns the extract dir.
+
+    The SEC requires a User-Agent that identifies the requester (name and email)
+    and throttles clients that exceed its fair-access rate; this makes a single
+    request per quarter with backoff on 429/5xx.
+    """
+    parse_quarter(quarter)
+    if not user_agent or "@" not in user_agent:
+        raise ValueError(
+            "SEC_USER_AGENT must identify you, e.g. 'Jane Doe jane@example.com' "
+            "(required by https://www.sec.gov/os/accessing-edgar-data)"
+        )
+
+    download_root.mkdir(parents=True, exist_ok=True)
+    zip_path = download_root / f"{quarter}.zip"
+    url = SEC_URL_TEMPLATE.format(quarter=quarter)
+    request = Request(url, headers={"User-Agent": user_agent})
+
+    for attempt in range(1, retries + 1):
+        try:
+            LOG.info("Downloading %s (attempt %d/%d)", url, attempt, retries)
+            partial = zip_path.with_suffix(".zip.part")
+            with urlopen(request, timeout=timeout) as response, partial.open("wb") as out:
+                shutil.copyfileobj(response, out, length=1024 * 1024)
+            partial.replace(zip_path)
+            break
+        except HTTPError as exc:
+            if exc.code == 404:
+                raise QuarterNotPublished(f"{quarter} is not published yet ({url})") from exc
+            if exc.code == 403:
+                raise PermissionError(
+                    f"sec.gov refused the request (HTTP 403) for {url}. Check that "
+                    "SEC_USER_AGENT contains your name and email, and that you are "
+                    "not exceeding the SEC's request-rate limit."
+                ) from exc
+            if exc.code in RETRYABLE_STATUS and attempt < retries:
+                time.sleep(backoff_seconds * 2 ** (attempt - 1))
+                continue
+            raise
+        except URLError:
+            if attempt < retries:
+                time.sleep(backoff_seconds * 2 ** (attempt - 1))
+                continue
+            raise
+
+    extract_dir = download_root / quarter
+    extract_dir.mkdir(parents=True, exist_ok=True)
+    with zipfile.ZipFile(zip_path) as archive:
+        members = set(archive.namelist())
+        for layout in LAYOUTS:
+            if layout.file_name not in members:
+                raise FileNotFoundError(f"{zip_path} does not contain {layout.file_name}")
+            # Extract by known name only: never trust paths inside an archive.
+            with archive.open(layout.file_name) as src, (extract_dir / layout.file_name).open("wb") as dst:
+                shutil.copyfileobj(src, dst)
+    LOG.info("Extracted %s to %s", zip_path.name, extract_dir)
+    return extract_dir
diff --git a/ingestion/warehouses.py b/ingestion/warehouses.py
new file mode 100644
index 0000000..e215109
--- /dev/null
+++ b/ingestion/warehouses.py
@@ -0,0 +1,226 @@
+"""Warehouse writers. Both implement the same contract for one quarter:
+
+1. Delete any rows previously loaded for the quarter, then load the four files,
+   in ONE transaction. Re-running a quarter replaces it instead of duplicating it,
+   and a failure leaves the previous load intact.
+2. Reconcile: the rows the warehouse reports as loaded must equal the rows the
+   loader counted in each file, or the transaction is rolled back.
+"""
+
+from __future__ import annotations
+
+import logging
+from dataclasses import dataclass
+from pathlib import Path
+
+from ingestion.quarters import parse_quarter
+from ingestion.sec_layout import LAYOUTS, METADATA_COLUMNS, FileLayout
+
+LOG = logging.getLogger(__name__)
+
+
+class LoadReconciliationError(RuntimeError):
+    """The warehouse loaded a different number of rows than the file contains."""
+
+
+@dataclass(frozen=True)
+class FilePlan:
+    """A validated source file, ready to load."""
+
+    layout: FileLayout
+    path: Path
+    positions: dict[str, int | None]  # canonical column -> 1-based position, None if absent
+    header: list[str]
+    expected_rows: int
+
+
+def _raw_table_columns_ddl(layout: FileLayout, timestamp_type: str) -> str:
+    columns = [f"{column} varchar" for column in layout.columns]
+    columns += [
+        "_source_quarter varchar",
+        "_source_file varchar",
+        f"_loaded_at {timestamp_type}",
+    ]
+    return ", ".join(columns)
+
+
+class DuckDBWarehouse:
+    """Local warehouse used for offline development and CI."""
+
+    def __init__(self, path: Path, schema: str = "raw_sec") -> None:
+        import duckdb
+
+        path.parent.mkdir(parents=True, exist_ok=True)
+        self.path = path
+        self.schema = schema
+        self.con = duckdb.connect(str(path))
+        self._ensure_tables()
+
+    def _ensure_tables(self) -> None:
+        self.con.execute(f"create schema if not exists {self.schema}")
+        for layout in LAYOUTS:
+            self.con.execute(
+                f"create table if not exists {self.schema}.{layout.table_name} "
+                f"({_raw_table_columns_ddl(layout, 'timestamp with time zone')})"
+            )
+
+    def loaded_quarters(self) -> set[str]:
+        rows = self.con.execute(f"select distinct _source_quarter from {self.schema}.sub").fetchall()
+        return {row[0] for row in rows}
+
+    def load_quarter(self, quarter: str, plans: list[FilePlan]) -> dict[str, int]:
+        parse_quarter(quarter)
+        loaded: dict[str, int] = {}
+        self.con.execute("begin transaction")
+        try:
+            for plan in plans:
+                table = f"{self.schema}.{plan.layout.table_name}"
+                self.con.execute(f"delete from {table} where _source_quarter = ?", [quarter])
+                # Every column is read as VARCHAR with quoting disabled: the SEC
+                # files are not quoted, so a literal " in a company name must
+                # stay a character, not start a quoted field.
+                file_columns = ", ".join(f"'{name}': 'VARCHAR'" for name in plan.header)
+                select_list = ", ".join(
+                    f'"{column}"' if plan.positions[column] else f"null as {column}"
+                    for column in plan.layout.columns
+                )
+                self.con.execute(
+                    f"insert into {table} "
+                    f"select {select_list}, ?, ?, current_timestamp "
+                    "from read_csv(?, delim = '\t', header = true, quote = '', "
+                    f"escape = '', auto_detect = false, columns = {{{file_columns}}})",
+                    [quarter, plan.path.name, str(plan.path)],
+                )
+                count = self.con.execute(
+                    f"select count(*) from {table} where _source_quarter = ?", [quarter]
+                ).fetchone()[0]
+                if count != plan.expected_rows:
+                    raise LoadReconciliationError(
+                        f"{quarter} {plan.layout.file_name}: file has {plan.expected_rows} "
+                        f"rows but {count} were loaded"
+                    )
+                loaded[plan.layout.table_name] = count
+            self.con.execute("commit")
+        except Exception:
+            self.con.execute("rollback")
+            raise
+        return loaded
+
+    def close(self) -> None:
+        self.con.close()
+
+
+class SnowflakeWarehouse:
+    """Loads into Snowflake through an internal stage: PUT, then COPY INTO.
+
+    Raw tables, the stage and the file format are created by
+    snowflake/setup/02_raw_tables.sql, not here, so the loader's role needs no
+    CREATE privileges.
+    """
+
+    stage = "sec_stage"
+    file_format = "sec_tsv"
+
+    def __init__(
+        self,
+        *,
+        account: str,
+        user: str,
+        private_key_path: str,
+        private_key_passphrase: str | None,
+        role: str,
+        warehouse: str,
+        database: str,
+        schema: str = "RAW_SEC",
+    ) -> None:
+        import snowflake.connector
+
+        self.schema = schema
+        self.con = snowflake.connector.connect(
+            account=account,
+            user=user,
+            private_key_file=str(Path(private_key_path).expanduser()),
+            private_key_file_pwd=private_key_passphrase or None,
+            role=role,
+            warehouse=warehouse,
+            database=database,
+            schema=schema,
+            session_parameters={"QUERY_TAG": "sec_analytics_loader"},
+        )
+        self._check_objects_exist()
+
+    def _check_objects_exist(self) -> None:
+        cursor = self.con.cursor()
+        cursor.execute(f"show tables in schema {self.schema}")
+        name_index = [col[0].lower() for col in cursor.description].index("name")
+        existing = {row[name_index].lower() for row in cursor.fetchall()}
+        missing = [layout.table_name for layout in LAYOUTS if layout.table_name not in existing]
+        if missing:
+            raise RuntimeError(
+                f"raw tables {missing} not found in {self.schema}. Run "
+                "snowflake/setup/02_raw_tables.sql as SEC_LOADER first."
+            )
+
+    def loaded_quarters(self) -> set[str]:
+        cursor = self.con.cursor()
+        cursor.execute(f"select distinct _source_quarter from {self.schema}.sub")
+        return {row[0] for row in cursor.fetchall()}
+
+    def copy_statement(self, quarter: str, plan: FilePlan) -> str:
+        """COPY INTO with an explicit column mapping built from the file header."""
+        parse_quarter(quarter)  # validated, so safe to inline as a literal
+        target_columns = ", ".join(plan.layout.columns + METADATA_COLUMNS)
+        select_list = ", ".join(
+            f"${plan.positions[column]}" if plan.positions[column] else "null"
+            for column in plan.layout.columns
+        )
+        return (
+            f"copy into {self.schema}.{plan.layout.table_name} ({target_columns}) "
+            f"from (select {select_list}, '{quarter}', metadata$filename, current_timestamp() "
+            f"from @{self.schema}.{self.stage}/{quarter}/{plan.path.name}.gz) "
+            f"file_format = (format_name = '{self.schema}.{self.file_format}') "
+            # FORCE: Snowflake skips files it loaded in the last 64 days. We just
+            # deleted the quarter's rows, so the reload must not be skipped.
+            "force = true on_error = 'abort_statement'"
+        )
+
+    def load_quarter(self, quarter: str, plans: list[FilePlan]) -> dict[str, int]:
+        parse_quarter(quarter)
+        cursor = self.con.cursor()
+        stage_path = f"@{self.schema}.{self.stage}/{quarter}/"
+        for plan in plans:
+            # PUT is a file transfer, not DML, so it runs before the transaction.
+            local = plan.path.resolve().as_posix()
+            cursor.execute(f"put 'file://{local}' {stage_path} auto_compress = true overwrite = true")
+
+        loaded: dict[str, int] = {}
+        cursor.execute("begin transaction")
+        try:
+            for plan in plans:
+                table = f"{self.schema}.{plan.layout.table_name}"
+                cursor.execute(f"delete from {table} where _source_quarter = %s", (quarter,))
+                cursor.execute(self.copy_statement(quarter, plan))
+                columns = [col[0].lower() for col in cursor.description]
+                results = cursor.fetchall()
+                # A header-only file returns a single status column, no rows_loaded.
+                rows_loaded = (
+                    sum(row[columns.index("rows_loaded")] for row in results)
+                    if "rows_loaded" in columns
+                    else 0
+                )
+                if rows_loaded != plan.expected_rows:
+                    raise LoadReconciliationError(
+                        f"{quarter} {plan.layout.file_name}: file has {plan.expected_rows} "
+                        f"rows but COPY loaded {rows_loaded}"
+                    )
+                loaded[plan.layout.table_name] = rows_loaded
+            cursor.execute("commit")
+        except Exception:
+            cursor.execute("rollback")
+            raise
+        finally:
+            cursor.execute(f"remove {stage_path}")
+        return loaded
+
+    def close(self) -> None:
+        self.con.close()
