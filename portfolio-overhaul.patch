diff --git a/tests/assert_annual_figures_reconcile_to_atomic_facts.sql b/tests/assert_annual_figures_reconcile_to_atomic_facts.sql
new file mode 100644
index 0000000..ada18db
--- /dev/null
+++ b/tests/assert_annual_figures_reconcile_to_atomic_facts.sql
@@ -0,0 +1,67 @@
+/*
+    Reconciliation between the two independent paths through the project:
+
+      * the pivot path (classified -> pivoted -> annual), and
+      * the incremental atomic fact table (fct_financial_facts).
+
+    Every annual revenue and net income figure must equal the consolidated
+    full-year fact, in fct_financial_facts, for the same filing and the tag the
+    pivot recorded as its source. A mismatch means one path dropped,
+    duplicated or altered a value -- for example, an incremental run that
+    missed a reloaded quarter.
+*/
+
+with annual as (
+
+    select
+        source_filing_id,
+        fiscal_year_end_date,
+        'revenue' as concept,
+        revenue_tag as tag,
+        revenue as value
+    from {{ ref('fct_company_financials_annual') }}
+    where revenue is not null
+
+    union all
+
+    select
+        source_filing_id,
+        fiscal_year_end_date,
+        'net_income' as concept,
+        net_income_tag as tag,
+        net_income as value
+    from {{ ref('fct_company_financials_annual') }}
+    where net_income is not null
+
+),
+
+facts as (
+
+    select
+        filing_id,
+        tag,
+        period_end_date,
+        fact_value
+    from {{ ref('fct_financial_facts') }}
+    where
+        is_consolidated
+        and duration_quarters = 4
+        and unit_of_measure = 'USD'
+
+)
+
+select
+    annual.source_filing_id,
+    annual.concept,
+    annual.tag,
+    annual.value as annual_value,
+    facts.fact_value as atomic_value
+from annual
+left join facts
+    on
+        annual.source_filing_id = facts.filing_id
+        and annual.tag = facts.tag
+        and abs({{ dbt.datediff('annual.fiscal_year_end_date', 'facts.period_end_date', 'day') }}) <= 15
+where
+    facts.fact_value is null
+    or facts.fact_value != annual.value
diff --git a/tests/assert_balance_sheet_balances.sql b/tests/assert_balance_sheet_balances.sql
new file mode 100644
index 0000000..f1b6b64
--- /dev/null
+++ b/tests/assert_balance_sheet_balances.sql
@@ -0,0 +1,32 @@
+{{
+    config(
+        severity='error',
+        warn_if='>0',
+        error_if='>2000',
+        store_failures=true
+    )
+}}
+
+/*
+    Assets = Liabilities + Equity, within a tolerance relative to total assets.
+
+    Warns rather than errors at low volume: some companies legitimately fail
+    the identity as modelled here -- redeemable preferred stock classified as
+    temporary ("mezzanine") equity, or non-controlling interests outside parent
+    equity. Blocking every build on those would teach people to ignore the
+    test. Past 2,000 failures the tag mapping is broken, not the filers, and it
+    becomes an error.
+
+    Failing rows are stored (store_failures) so they can be inspected.
+*/
+
+select
+    cik,
+    company_name,
+    fiscal_year,
+    total_assets,
+    total_liabilities,
+    total_equity,
+    total_assets - (total_liabilities + total_equity) as imbalance
+from {{ ref('fct_company_financials_annual') }}
+where balance_sheet_balances = false
diff --git a/tests/assert_company_history_has_no_overlaps.sql b/tests/assert_company_history_has_no_overlaps.sql
new file mode 100644
index 0000000..264060a
--- /dev/null
+++ b/tests/assert_company_history_has_no_overlaps.sql
@@ -0,0 +1,27 @@
+/*
+    SCD2 integrity for dim_company_history: a company's versions must chain
+    with no gaps and no overlaps -- each version's valid_to equals the next
+    version's valid_from -- and only the final version may be open-ended.
+    Overlaps would make a point-in-time join return two rows (fan-out); gaps
+    would make it return none.
+*/
+
+with ordered as (
+
+    select
+        cik,
+        version_number,
+        valid_from,
+        valid_to,
+        is_current,
+        lead(valid_from) over (partition by cik order by valid_from) as next_valid_from
+    from {{ ref('dim_company_history') }}
+
+)
+
+select *
+from ordered
+where
+    (next_valid_from is not null and (valid_to is null or valid_to != next_valid_from))
+    or (next_valid_from is null and (valid_to is not null or not is_current))
+    or valid_to <= valid_from
diff --git a/tests/assert_derived_q4_reconciles_to_annual.sql b/tests/assert_derived_q4_reconciles_to_annual.sql
new file mode 100644
index 0000000..76c650c
--- /dev/null
+++ b/tests/assert_derived_q4_reconciles_to_annual.sql
@@ -0,0 +1,39 @@
+/*
+    Reconciliation: for every fiscal year with a derived Q4, Q1 + Q2 + Q3 + Q4
+    must equal the annual figure exactly.
+
+    True by construction for a correct model, which is the point: it fails if
+    the quarterly join duplicates a quarter, picks a quarter from the wrong
+    fiscal year, or derives Q4 from an incomplete set.
+*/
+
+with quarter_sums as (
+
+    select
+        cik,
+        fiscal_year,
+        sum(revenue) as summed_revenue,
+        sum(net_income) as summed_net_income,
+        count(revenue) as revenue_quarters,
+        count(net_income) as net_income_quarters
+    from {{ ref('fct_company_financials_quarterly') }}
+    group by cik, fiscal_year
+    having max(case when is_derived_q4 then 1 else 0 end) = 1
+
+)
+
+select
+    quarter_sums.cik,
+    quarter_sums.fiscal_year,
+    annual.revenue,
+    quarter_sums.summed_revenue,
+    annual.net_income,
+    quarter_sums.summed_net_income
+from quarter_sums
+inner join {{ ref('fct_company_financials_annual') }} as annual
+    on
+        quarter_sums.cik = annual.cik
+        and quarter_sums.fiscal_year = annual.fiscal_year
+where
+    (quarter_sums.revenue_quarters = 4 and quarter_sums.summed_revenue != annual.revenue)
+    or (quarter_sums.net_income_quarters = 4 and quarter_sums.summed_net_income != annual.net_income)
diff --git a/tests/assert_no_annual_quarterly_mixing.sql b/tests/assert_no_annual_quarterly_mixing.sql
new file mode 100644
index 0000000..dc34af3
--- /dev/null
+++ b/tests/assert_no_annual_quarterly_mixing.sql
@@ -0,0 +1,25 @@
+/*
+    Annual revenue can never be smaller than a single quarter of the same
+    fiscal year. If it is, durations have been mixed somewhere: a quarterly
+    value landed in the annual table, or an annual one in a quarter.
+
+    Derived Q4 rows are excluded: they are computed FROM the annual figure, so
+    comparing them to it proves nothing (and a restatement between the 10-Qs
+    and the 10-K can legitimately push a derived Q4 negative).
+*/
+
+select
+    annual.cik,
+    annual.fiscal_year,
+    annual.revenue as annual_revenue,
+    quarterly.fiscal_quarter,
+    quarterly.revenue as quarterly_revenue
+from {{ ref('fct_company_financials_annual') }} as annual
+inner join {{ ref('fct_company_financials_quarterly') }} as quarterly
+    on
+        annual.cik = quarterly.cik
+        and annual.fiscal_year = quarterly.fiscal_year
+where
+    not quarterly.is_derived_q4
+    and quarterly.revenue > 0
+    and annual.revenue < quarterly.revenue
diff --git a/tests/assert_numeric_values_parse.sql b/tests/assert_numeric_values_parse.sql
new file mode 100644
index 0000000..15dc063
--- /dev/null
+++ b/tests/assert_numeric_values_parse.sql
@@ -0,0 +1,28 @@
+{{
+    config(
+        severity='warn',
+        store_failures=true
+    )
+}}
+
+/*
+    Numeric values that arrived but could not be parsed as decimals.
+
+    The loader keeps every row as text, and staging uses try_cast, so a
+    malformed value becomes NULL instead of failing the load. This test is
+    what stops that NULL from going unnoticed. Warn-level: one bad value
+    should not block a build, but it must be visible (and is stored for
+    inspection).
+*/
+
+select
+    fact_key,
+    filing_id,
+    tag,
+    period_end_date,
+    fact_value_raw,
+    source_quarter
+from {{ ref('stg_sec__numeric_facts') }}
+where
+    fact_value_raw is not null
+    and fact_value is null
diff --git a/tests/assert_sic_ranges_do_not_overlap.sql b/tests/assert_sic_ranges_do_not_overlap.sql
new file mode 100644
index 0000000..ad8c706
--- /dev/null
+++ b/tests/assert_sic_ranges_do_not_overlap.sql
@@ -0,0 +1,29 @@
+/*
+    The SIC seed is joined with BETWEEN. If two ranges overlap, every company in
+    the overlap matches twice: dim_company_history duplicates its rows and every
+    downstream join fans out, inflating totals with no error anywhere.
+
+    The seed and this test are a package: neither is correct without the other.
+    Returns each overlapping pair, plus any inverted range (low > high).
+*/
+
+select
+    a.sic_low as range_a_low,
+    a.sic_high as range_a_high,
+    b.sic_low as range_b_low,
+    b.sic_high as range_b_high
+from {{ ref('sic_sector_mapping') }} as a
+inner join {{ ref('sic_sector_mapping') }} as b
+    on
+        a.sic_low < b.sic_low
+        and a.sic_high >= b.sic_low
+
+union all
+
+select
+    sic_low as range_a_low,
+    sic_high as range_a_high,
+    null as range_b_low,
+    null as range_b_high
+from {{ ref('sic_sector_mapping') }}
+where sic_low > sic_high
diff --git a/tests/generic/not_null_proportion.sql b/tests/generic/not_null_proportion.sql
new file mode 100644
index 0000000..eef2bc0
--- /dev/null
+++ b/tests/generic/not_null_proportion.sql
@@ -0,0 +1,30 @@
+{#
+    Fails when the share of non-null values in a column drops below `at_least`.
+
+    Plain not_null is too strict for public filings: many companies legitimately
+    report no inventory or no R&D. But a column going from 95% populated to 12%
+    is a real incident -- usually a tag-mapping or parsing regression -- and this
+    catches it without failing on legitimate sparsity.
+
+    Returns one row (the observed proportion) when the check fails.
+#}
+{% test not_null_proportion(model, column_name, at_least) %}
+
+with stats as (
+
+    select
+        count(*) as total_rows,
+        count({{ column_name }}) as non_null_rows
+    from {{ model }}
+
+)
+
+select
+    total_rows,
+    non_null_rows,
+    cast(non_null_rows as double) / total_rows as non_null_proportion
+from stats
+where total_rows > 0
+  and cast(non_null_rows as double) / total_rows < {{ at_least }}
+
+{% endtest %}
