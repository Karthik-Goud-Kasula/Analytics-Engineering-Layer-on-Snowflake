+version: 2
+
+models:
+  - name: int_filings__deduplicated
+    description: >
+      One authoritative filing per (company, period end, base form type), chosen
+      from 10-K/10-Q filings that contain primary financial statements: the most
+      recently filed wins. Superseded filings are kept elsewhere for
+      mart_restatements.
+    data_tests:
+      - dbt_utils.unique_combination_of_columns:
+          arguments:
+            combination_of_columns: ["company_id", "period_end_date", "base_form_type"]
+    columns:
+      - name: filing_id
+        description: Accession number of the authoritative filing.
+        data_tests:
+          - not_null
+          - unique
+          - relationships:
+              arguments:
+                to: ref('stg_sec__submissions')
+                field: filing_id
+      - name: company_id
+        description: CIK.
+        data_tests: [not_null]
+      - name: period_end_date
+        description: Period the filing reports on.
+      - name: base_form_type
+        description: 10-K or 10-Q.
+        data_tests:
+          - accepted_values:
+              arguments:
+                values: ["10-K", "10-Q"]
+      - name: form_type
+        description: Actual form of the winner (10-K/A when an amendment won).
+      - name: has_superseded_filings
+        description: True when another filing for the same company-period lost.
+
+  - name: int_facts__classified
+    description: >
+      Consolidated, current-period facts from 10-K/10-Q filings that are
+      presented on a primary statement, each classified to exactly one statement.
+      One row per fact_key; superseded filings included.
+    columns:
+      - name: fact_key
+        description: Grain key from stg_sec__numeric_facts.
+        data_tests: [not_null, unique]
+      - name: statement_name
+        description: income_statement, balance_sheet, cash_flow, comprehensive_income or equity.
+        data_tests:
+          - not_null
+          - accepted_values:
+              arguments:
+                values: ["income_statement", "balance_sheet", "cash_flow", "comprehensive_income", "equity"]
+      - name: period_type
+        description: instant, quarter, annual or year_to_date (from duration_quarters).
+      - name: is_custom_tag
+        description: True for filer-defined tags; excluded from the cross-company pivots.
+      - name: is_authoritative_filing
+        description: True when the fact's filing is the one int_filings__deduplicated chose.
+
+  - name: int_facts__income_statement
+    description: >
+      Income statement concepts pivoted to columns. One row per (filing_id,
+      duration_quarters); every value in a row comes from the same filing.
+    data_tests:
+      - dbt_utils.unique_combination_of_columns:
+          arguments:
+            combination_of_columns: ["filing_id", "duration_quarters"]
+    columns:
+      - name: income_statement_key
+        description: Hash of filing_id and duration_quarters.
+        data_tests: [not_null, unique]
+      - name: duration_quarters
+        description: 1 = quarter, 2-3 = year to date, 4 = full year.
+        data_tests:
+          - accepted_values:
+              arguments:
+                values: [1, 2, 3, 4]
+              config:
+                severity: warn
+      - name: revenue
+        description: Top-line revenue from the highest-priority mapped tag.
+        data_tests:
+          - not_null_proportion:
+              arguments:
+                at_least: 0.7
+              config:
+                severity: warn
+      - name: revenue_tag
+        description: The XBRL tag that supplied revenue (lineage).
+      - name: net_income_tag
+        description: The XBRL tag that supplied net income (lineage).
+      - name: is_gross_profit_derived
+        description: True when gross profit was computed as revenue minus cost of revenue.
+      - name: eps_basic
+        description: Basic EPS (reported in USD/shares).
+        data_tests:
+          - not_null_proportion:
+              arguments:
+                at_least: 0.5
+              config:
+                severity: warn
+
+  - name: int_facts__balance_sheet
+    description: Balance sheet concepts pivoted to columns. One row per filing.
+    columns:
+      - name: balance_sheet_key
+        description: Hash of filing_id.
+        data_tests: [not_null, unique]
+      - name: filing_id
+        description: Accession number.
+        data_tests: [not_null, unique]
+      - name: total_assets
+        description: Total assets.
+        data_tests:
+          - not_null_proportion:
+              arguments:
+                at_least: 0.9
+              config:
+                severity: warn
+      - name: total_debt
+        description: Current portion + short-term borrowings + non-current debt; NULL when none is tagged.
+
+  - name: int_facts__cash_flow
+    description: >
+      Cash flow concepts pivoted to columns. One row per (filing_id,
+      duration_quarters). 10-Q values are year to date.
+    data_tests:
+      - dbt_utils.unique_combination_of_columns:
+          arguments:
+            combination_of_columns: ["filing_id", "duration_quarters"]
+    columns:
+      - name: cash_flow_key
+        description: Hash of filing_id and duration_quarters.
+        data_tests: [not_null, unique]
+      - name: free_cash_flow
+        description: Operating cash flow minus capital expenditure; NULL unless both are reported.
+
+  - name: int_financials__annual
+    description: >
+      Income statement, balance sheet and cash flow of each authoritative 10-K,
+      joined on filing. One row per (company_id, fiscal_year).
+    data_tests:
+      - dbt_utils.unique_combination_of_columns:
+          arguments:
+            combination_of_columns: ["company_id", "fiscal_year"]
+    columns:
+      - name: source_filing_id
+        description: The 10-K or 10-K/A every value in the row came from.
+        data_tests: [not_null, unique]
+
+  - name: int_financials__quarterly
+    description: >
+      Quarterly income statement (Q1-Q3 reported, Q4 derived as annual minus
+      Q1-Q3). One row per (company_id, fiscal_year, fiscal_quarter).
+    data_tests:
+      - dbt_utils.unique_combination_of_columns:
+          arguments:
+            combination_of_columns: ["company_id", "fiscal_year", "fiscal_quarter"]
+    columns:
+      - name: quarterly_financials_key
+        description: Hash of company_id, fiscal_year and fiscal_quarter.
+        data_tests: [not_null, unique]
+      - name: fiscal_quarter
+        description: 1-4.
+        data_tests:
+          - accepted_values:
+              arguments:
+                values: [1, 2, 3, 4]
+      - name: is_derived_q4
+        description: True for computed Q4 rows.
+      - name: has_complete_quarters
+        description: True when Q1, Q2 and Q3 were all reported for the fiscal year.
+
+unit_tests:
+  - name: test_dedup_ignores_amendment_without_statements
+    description: >
+      A Part III 10-K/A (no financial statements) must not replace the original
+      10-K, even though it is filed later and the original is flagged prevrpt.
+      A 10-K/A that does carry statements must win.
+    model: int_filings__deduplicated
+    given:
+      - input: ref('stg_sec__submissions')
+        rows:
+          - {filing_id: "a-original", company_id: 1, period_end_date: 2023-12-31, base_form_type: "10-K", form_type: "10-K", is_amendment: false, filed_date: 2024-02-20, accepted_at: "2024-02-20 16:00:00", is_subsequently_amended: true}
+          - {filing_id: "a-part3", company_id: 1, period_end_date: 2023-12-31, base_form_type: "10-K", form_type: "10-K/A", is_amendment: true, filed_date: 2024-03-28, accepted_at: "2024-03-28 16:00:00", is_subsequently_amended: false}
+          - {filing_id: "b-original", company_id: 2, period_end_date: 2023-12-31, base_form_type: "10-K", form_type: "10-K", is_amendment: false, filed_date: 2024-02-20, accepted_at: "2024-02-20 16:00:00", is_subsequently_amended: false}
+          - {filing_id: "b-restated", company_id: 2, period_end_date: 2023-12-31, base_form_type: "10-K", form_type: "10-K/A", is_amendment: true, filed_date: 2024-06-14, accepted_at: "2024-06-14 16:00:00", is_subsequently_amended: false}
+          - {filing_id: "c-20f", company_id: 3, period_end_date: 2023-12-31, base_form_type: "20-F", form_type: "20-F", is_amendment: false, filed_date: 2024-04-22, accepted_at: "2024-04-22 16:00:00", is_subsequently_amended: false}
+      - input: ref('stg_sec__presentation')
+        rows:
+          - {filing_id: "a-original", statement_code: "IS", is_parenthetical: false}
+          - {filing_id: "a-part3", statement_code: "CP", is_parenthetical: false}
+          - {filing_id: "b-original", statement_code: "IS", is_parenthetical: false}
+          - {filing_id: "b-restated", statement_code: "BS", is_parenthetical: false}
+          - {filing_id: "c-20f", statement_code: "IS", is_parenthetical: false}
+    expect:
+      rows:
+        - {filing_id: "a-original", company_id: 1, has_superseded_filings: false}
+        - {filing_id: "b-restated", company_id: 2, has_superseded_filings: true}
+
+  - name: test_income_statement_tag_priority_and_eps_unit
+    description: >
+      When two mapped tags report revenue, the higher-priority tag wins. EPS is
+      reported in USD/shares and must still be picked up. Custom tags are ignored.
+    model: int_facts__income_statement
+    given:
+      - input: ref('int_facts__classified')
+        rows:
+          - {filing_id: "f1", company_id: 1, period_end_date: 2023-12-31, duration_quarters: 4, period_type: "annual", statement_name: "income_statement", is_custom_tag: false, tag: "Revenues", unit_of_measure: "USD", fact_value: 482500000}
+          - {filing_id: "f1", company_id: 1, period_end_date: 2023-12-31, duration_quarters: 4, period_type: "annual", statement_name: "income_statement", is_custom_tag: false, tag: "RevenueFromContractWithCustomerExcludingAssessedTax", unit_of_measure: "USD", fact_value: 480000000}
+          - {filing_id: "f1", company_id: 1, period_end_date: 2023-12-31, duration_quarters: 4, period_type: "annual", statement_name: "income_statement", is_custom_tag: true, tag: "Revenues", unit_of_measure: "USD", fact_value: 1}
+          - {filing_id: "f1", company_id: 1, period_end_date: 2023-12-31, duration_quarters: 4, period_type: "annual", statement_name: "income_statement", is_custom_tag: false, tag: "EarningsPerShareBasic", unit_of_measure: "USD/shares", fact_value: 1.85}
+          - {filing_id: "f1", company_id: 1, period_end_date: 2023-12-31, duration_quarters: 4, period_type: "annual", statement_name: "income_statement", is_custom_tag: false, tag: "CostOfRevenue", unit_of_measure: "USD", fact_value: 96000000}
+      - input: ref('financial_tag_mapping')
+        rows:
+          - {tag: "RevenueFromContractWithCustomerExcludingAssessedTax", unit_of_measure: "USD", concept: "revenue", statement: "income_statement", priority: 1}
+          - {tag: "Revenues", unit_of_measure: "USD", concept: "revenue", statement: "income_statement", priority: 3}
+          - {tag: "CostOfRevenue", unit_of_measure: "USD", concept: "cost_of_revenue", statement: "income_statement", priority: 1}
+          - {tag: "EarningsPerShareBasic", unit_of_measure: "USD/shares", concept: "eps_basic", statement: "income_statement", priority: 1}
+    expect:
+      rows:
+        - {filing_id: "f1", revenue: 480000000, revenue_tag: "RevenueFromContractWithCustomerExcludingAssessedTax", eps_basic: 1.85, gross_profit: 384000000, is_gross_profit_derived: true}
+
+  - name: test_q4_derived_only_from_complete_quarters
+    description: >
+      Q4 = annual - (Q1 + Q2 + Q3) when all three quarters exist; no Q4 row is
+      produced when a quarter is missing; derived EPS is NULL.
+    model: int_financials__quarterly
+    given:
+      - input: ref('int_filings__deduplicated')
+        rows:
+          - {filing_id: "q1", company_id: 1, fiscal_year: 2023, fiscal_period: "Q1", base_form_type: "10-Q", period_end_date: 2023-03-31, filed_date: 2023-05-01}
+          - {filing_id: "q2", company_id: 1, fiscal_year: 2023, fiscal_period: "Q2", base_form_type: "10-Q", period_end_date: 2023-06-30, filed_date: 2023-08-01}
+          - {filing_id: "q3", company_id: 1, fiscal_year: 2023, fiscal_period: "Q3", base_form_type: "10-Q", period_end_date: 2023-09-30, filed_date: 2023-11-01}
+          - {filing_id: "x1", company_id: 2, fiscal_year: 2023, fiscal_period: "Q1", base_form_type: "10-Q", period_end_date: 2023-03-31, filed_date: 2023-05-01}
+          - {filing_id: "x3", company_id: 2, fiscal_year: 2023, fiscal_period: "Q3", base_form_type: "10-Q", period_end_date: 2023-09-30, filed_date: 2023-11-01}
+      - input: ref('int_facts__income_statement')
+        rows:
+          - {filing_id: "q1", duration_quarters: 1, revenue: 100, net_income: 10, eps_basic: 0.10}
+          - {filing_id: "q2", duration_quarters: 1, revenue: 110, net_income: 11, eps_basic: 0.11}
+          - {filing_id: "q2", duration_quarters: 2, revenue: 210, net_income: 21, eps_basic: 0.21}
+          - {filing_id: "q3", duration_quarters: 1, revenue: 120, net_income: null, eps_basic: 0.12}
+          - {filing_id: "x1", duration_quarters: 1, revenue: 50, net_income: 5}
+          - {filing_id: "x3", duration_quarters: 1, revenue: 55, net_income: 6}
+      - input: ref('int_financials__annual')
+        rows:
+          - {company_id: 1, fiscal_year: 2023, fiscal_year_end_date: 2023-12-31, source_filing_id: "k1", revenue: 470, net_income: 45}
+          - {company_id: 2, fiscal_year: 2023, fiscal_year_end_date: 2023-12-31, source_filing_id: "k2", revenue: 230, net_income: 22}
+    # Every expected row lists the same columns (dbt compares on that set).
+    expect:
+      rows:
+        - {company_id: 1, fiscal_quarter: 1, revenue: 100, net_income: 10, eps_basic: 0.10, is_derived_q4: false, has_complete_quarters: true}
+        - {company_id: 1, fiscal_quarter: 2, revenue: 110, net_income: 11, eps_basic: 0.11, is_derived_q4: false, has_complete_quarters: true}
+        - {company_id: 1, fiscal_quarter: 3, revenue: 120, net_income: null, eps_basic: 0.12, is_derived_q4: false, has_complete_quarters: true}
+        # Revenue is derived (470 - 330); net income is not, because Q3 net
+        # income is missing; per-share figures are never derived.
+        - {company_id: 1, fiscal_quarter: 4, revenue: 140, net_income: null, eps_basic: null, is_derived_q4: true, has_complete_quarters: true}
+        # Company 2 has no Q2, so no Q4 row at all.
+        - {company_id: 2, fiscal_quarter: 1, revenue: 50, net_income: 5, eps_basic: null, is_derived_q4: false, has_complete_quarters: false}
+        - {company_id: 2, fiscal_quarter: 3, revenue: 55, net_income: 6, eps_basic: null, is_derived_q4: false, has_complete_quarters: false}
diff --git a/models/intermediate/int_facts__balance_sheet.sql b/models/intermediate/int_facts__balance_sheet.sql
new file mode 100644
index 0000000..f50adfe
--- /dev/null
+++ b/models/intermediate/int_facts__balance_sheet.sql
@@ -0,0 +1,105 @@
+/*
+    Balance sheet line items, pivoted into named columns.
+
+    Grain: one row per filing_id. Balance sheet items are instants
+    (duration_quarters = 0) at the filing's own period end.
+
+    total_debt is derived: SEC filers split debt across current portion,
+    short-term borrowings and non-current tags, and many report no total. It is
+    NULL only when none of the three is reported (no debt tagged), not when one
+    of them is missing. Lease liabilities are not included.
+*/
+
+{% set concepts = [
+    'cash_and_equivalents', 'short_term_investments', 'accounts_receivable',
+    'inventory', 'total_current_assets', 'total_assets',
+    'total_current_liabilities', 'total_liabilities', 'debt_current',
+    'short_term_borrowings', 'debt_noncurrent', 'total_equity',
+    'total_liabilities_and_equity'
+] %}
+
+with facts as (
+
+    select *
+    from {{ ref('int_facts__classified') }}
+    where
+        statement_name = 'balance_sheet'
+        and duration_quarters = 0
+        and not is_custom_tag
+
+),
+
+mapping as (
+
+    select
+        tag,
+        unit_of_measure,
+        concept,
+        priority
+    from {{ ref('financial_tag_mapping') }}
+    where statement = 'balance_sheet'
+
+),
+
+deduped as (
+
+    select
+        facts.filing_id,
+        facts.company_id,
+        facts.period_end_date,
+        mapping.concept,
+        facts.tag,
+        facts.fact_value
+    from facts
+    inner join mapping
+        on
+            facts.tag = mapping.tag
+            and facts.unit_of_measure = mapping.unit_of_measure
+    qualify row_number() over (
+        partition by facts.filing_id, mapping.concept
+        order by mapping.priority asc, facts.tag asc
+    ) = 1
+
+),
+
+pivoted as (
+
+    select
+        filing_id,
+        company_id,
+        period_end_date,
+        {{ pivot_concepts(concepts) }}
+    from deduped
+    group by
+        filing_id,
+        company_id,
+        period_end_date
+
+)
+
+select
+    {{ dbt_utils.generate_surrogate_key(['filing_id']) }} as balance_sheet_key,
+    filing_id,
+    company_id,
+    period_end_date,
+    cash_and_equivalents,
+    short_term_investments,
+    accounts_receivable,
+    inventory,
+    total_current_assets,
+    total_assets,
+    total_current_liabilities,
+    total_liabilities,
+    debt_current,
+    short_term_borrowings,
+    debt_noncurrent,
+    case
+        when coalesce(debt_current, short_term_borrowings, debt_noncurrent) is not null
+            then
+                coalesce(debt_current, 0)
+                + coalesce(short_term_borrowings, 0)
+                + coalesce(debt_noncurrent, 0)
+    end as total_debt,
+    total_equity,
+    total_liabilities_and_equity
+from pivoted
diff --git a/models/intermediate/int_facts__cash_flow.sql b/models/intermediate/int_facts__cash_flow.sql
new file mode 100644
index 0000000..37e8441
--- /dev/null
+++ b/models/intermediate/int_facts__cash_flow.sql
@@ -0,0 +1,95 @@
+/*
+    Cash flow statement line items, pivoted into named columns.
+
+    Grain: one row per (filing_id, duration_quarters). Note that 10-Q cash flow
+    statements are year-to-date (Q2 = 2 quarters, Q3 = 3), never a single
+    quarter, so there is no quarterly cash flow in the marts.
+
+    Capital expenditure is reported as a positive payment.
+*/
+
+{% set concepts = [
+    'operating_cash_flow', 'investing_cash_flow', 'financing_cash_flow',
+    'capital_expenditure', 'depreciation_amortization', 'dividends_paid',
+    'share_repurchases'
+] %}
+
+with facts as (
+
+    select *
+    from {{ ref('int_facts__classified') }}
+    where
+        statement_name = 'cash_flow'
+        and duration_quarters > 0
+        and not is_custom_tag
+
+),
+
+mapping as (
+
+    select
+        tag,
+        unit_of_measure,
+        concept,
+        priority
+    from {{ ref('financial_tag_mapping') }}
+    where statement = 'cash_flow'
+
+),
+
+deduped as (
+
+    select
+        facts.filing_id,
+        facts.company_id,
+        facts.period_end_date,
+        facts.duration_quarters,
+        mapping.concept,
+        facts.tag,
+        facts.fact_value
+    from facts
+    inner join mapping
+        on
+            facts.tag = mapping.tag
+            and facts.unit_of_measure = mapping.unit_of_measure
+    qualify row_number() over (
+        partition by facts.filing_id, facts.duration_quarters, mapping.concept
+        order by mapping.priority asc, facts.tag asc
+    ) = 1
+
+),
+
+pivoted as (
+
+    select
+        filing_id,
+        company_id,
+        period_end_date,
+        duration_quarters,
+        {{ pivot_concepts(concepts) }}
+    from deduped
+    group by
+        filing_id,
+        company_id,
+        period_end_date,
+        duration_quarters
+
+)
+
+select
+    {{ dbt_utils.generate_surrogate_key(['filing_id', 'duration_quarters']) }} as cash_flow_key,
+    filing_id,
+    company_id,
+    period_end_date,
+    duration_quarters,
+    operating_cash_flow,
+    investing_cash_flow,
+    financing_cash_flow,
+    capital_expenditure,
+    depreciation_amortization,
+    dividends_paid,
+    share_repurchases,
+    -- NULL unless both inputs are reported: free cash flow without capex
+    -- would silently overstate it.
+    operating_cash_flow - capital_expenditure as free_cash_flow
+from pivoted
diff --git a/models/intermediate/int_facts__classified.sql b/models/intermediate/int_facts__classified.sql
new file mode 100644
index 0000000..838f807
--- /dev/null
+++ b/models/intermediate/int_facts__classified.sql
@@ -0,0 +1,161 @@
+/*
+    Facts that belong on a company's primary financial statements, each
+    classified to exactly one statement.
+
+    One row per fact_key. Covers every 10-K/10-Q filing, superseded ones
+    included (is_authoritative_filing marks the winner from
+    int_filings__deduplicated), because mart_restatements compares the two.
+
+    Filters, and why each exists:
+
+    * Consolidated only (no segments, no co-registrant). Segment rows break a
+      total down; co-registrant rows belong to a subsidiary. Either one would
+      double-count or replace the company's own figure.
+    * Current period only: the fact's end date must match the filing's own
+      period. A 10-K also reports the prior year as a comparative column, often
+      recast. Taking each period from its own filing keeps one consistent
+      source per row ("as reported"); restatements are surfaced separately.
+      SEC rounds fact dates to the nearest month end, so the match allows 15
+      days of slack for 52/53-week fiscal years.
+    * Presented on a statement, not parenthetically. pre.txt says where a tag
+      was rendered; parenthetical lines ("net of allowance of $x") are not line
+      items. When a tag appears on more than one statement (net income on the
+      income statement and the cash flow statement), an explicit priority picks
+      one, so each fact is counted once.
+    * Not abstract, and with a value that parsed.
+*/
+
+with filings as (
+
+    select
+        filing_id,
+        company_id,
+        form_type,
+        base_form_type,
+        is_amendment,
+        period_end_date as filing_period_end_date,
+        fiscal_year,
+        fiscal_period,
+        filed_date,
+        accepted_at
+    from {{ ref('stg_sec__submissions') }}
+    where base_form_type in ('10-K', '10-Q')
+
+),
+
+authoritative as (
+
+    select filing_id from {{ ref('int_filings__deduplicated') }}
+
+),
+
+statement_classification as (
+
+    select
+        filing_id,
+        tag,
+        tag_version,
+        statement_code
+    from {{ ref('stg_sec__presentation') }}
+    where
+        not is_parenthetical
+        and statement_code in ('IS', 'BS', 'CF', 'CI', 'EQ')
+    qualify row_number() over (
+        partition by filing_id, tag, tag_version
+        order by
+            case statement_code
+                when 'IS' then 1
+                when 'BS' then 2
+                when 'CF' then 3
+                when 'CI' then 4
+                when 'EQ' then 5
+            end,
+            report_number,
+            line_number
+    ) = 1
+
+),
+
+tags as (
+
+    select
+        tag,
+        tag_version,
+        is_custom,
+        is_abstract
+    from {{ ref('stg_sec__tags') }}
+
+),
+
+facts as (
+
+    select
+        fact_key,
+        filing_id,
+        tag,
+        tag_version,
+        period_end_date,
+        duration_quarters,
+        unit_of_measure,
+        fact_value
+    from {{ ref('stg_sec__numeric_facts') }}
+    where
+        is_consolidated
+        and fact_value is not null
+
+)
+
+select
+    facts.fact_key,
+    facts.filing_id,
+    filings.company_id,
+    filings.form_type,
+    filings.base_form_type,
+    filings.is_amendment,
+    filings.fiscal_year,
+    filings.fiscal_period,
+    filings.filed_date,
+    filings.accepted_at,
+    facts.tag,
+    facts.tag_version,
+    facts.period_end_date,
+    facts.duration_quarters,
+    case
+        when facts.duration_quarters = 0 then 'instant'
+        when facts.duration_quarters = 1 then 'quarter'
+        when facts.duration_quarters = 4 then 'annual'
+        else 'year_to_date'
+    end as period_type,
+    facts.unit_of_measure,
+    facts.fact_value,
+    statement_classification.statement_code,
+    case statement_classification.statement_code
+        when 'IS' then 'income_statement'
+        when 'BS' then 'balance_sheet'
+        when 'CF' then 'cash_flow'
+        when 'CI' then 'comprehensive_income'
+        when 'EQ' then 'equity'
+    end as statement_name,
+    -- Custom tags carry the accession number as their version; fall back to
+    -- that rule if a tag is missing from the tag file.
+    coalesce(tags.is_custom, facts.tag_version = facts.filing_id) as is_custom_tag,
+    authoritative.filing_id is not null as is_authoritative_filing
+
+from facts
+inner join filings
+    on facts.filing_id = filings.filing_id
+inner join statement_classification
+    on
+        facts.filing_id = statement_classification.filing_id
+        and facts.tag = statement_classification.tag
+        and facts.tag_version = statement_classification.tag_version
+left join tags
+    on
+        facts.tag = tags.tag
+        and facts.tag_version = tags.tag_version
+left join authoritative
+    on facts.filing_id = authoritative.filing_id
+
+where
+    abs({{ dbt.datediff('filings.filing_period_end_date', 'facts.period_end_date', 'day') }}) <= 15
+    and not coalesce(tags.is_abstract, false)
diff --git a/models/intermediate/int_facts__income_statement.sql b/models/intermediate/int_facts__income_statement.sql
new file mode 100644
index 0000000..b07fff7
--- /dev/null
+++ b/models/intermediate/int_facts__income_statement.sql
@@ -0,0 +1,145 @@
+/*
+    Income statement line items, pivoted from tag rows into named columns.
+
+    Grain: one row per (filing_id, duration_quarters). A 10-K yields one annual
+    row (4 quarters); a 10-Q yields a quarter row (1) and, for Q2/Q3, a
+    year-to-date row (2 or 3). Every value in a row comes from the same filing.
+
+    Two hard problems this model solves:
+
+    1. TAG SYNONYMS. There is no single revenue tag. Depending on filer and
+       taxonomy year, top-line revenue is `Revenues`,
+       `RevenueFromContractWithCustomerExcludingAssessedTax`,
+       `SalesRevenueNet`, and several others. The seed
+       `financial_tag_mapping.csv` maps every known variant to a canonical
+       concept, with a priority so the most specific tag wins when a filer
+       reports more than one. The tag that won is kept (`revenue_tag`,
+       `net_income_tag`) so every figure can be traced back to its source.
+
+    2. DURATION MIXING. `qtrs = 4` is an annual figure and `qtrs = 1` is a
+       single quarter. Summing across them inflates results ~5x. This model
+       keeps them separate by carrying `duration_quarters` in the grain.
+
+    The mapping also matches on unit: earnings per share is reported in
+    USD/shares, so a USD-only filter would silently null every EPS value.
+*/
+
+{% set concepts = [
+    'revenue', 'cost_of_revenue', 'gross_profit', 'operating_expenses',
+    'research_and_development', 'sga_expense', 'operating_income',
+    'interest_expense', 'pretax_income', 'income_tax_expense', 'net_income',
+    'eps_basic', 'eps_diluted'
+] %}
+
+with facts as (
+
+    select *
+    from {{ ref('int_facts__classified') }}
+    where
+        statement_name in ('income_statement', 'comprehensive_income')
+        and duration_quarters > 0      -- income statement items are always flows
+        and not is_custom_tag          -- cross-company comparability
+
+),
+
+mapping as (
+
+    select
+        tag,
+        unit_of_measure,
+        concept,
+        priority
+    from {{ ref('financial_tag_mapping') }}
+    where statement = 'income_statement'
+
+),
+
+mapped as (
+
+    select
+        facts.filing_id,
+        facts.company_id,
+        facts.period_end_date,
+        facts.duration_quarters,
+        facts.period_type,
+        mapping.concept,
+        facts.tag,
+        facts.fact_value,
+        -- When a filer reports two tags that both map to the same concept,
+        -- take the highest-priority (most specific) one. Tag name is a
+        -- deterministic final tiebreak so reruns never flip the answer.
+        row_number() over (
+            partition by facts.filing_id, facts.duration_quarters, mapping.concept
+            order by mapping.priority asc, facts.tag asc
+        ) as concept_rank
+    from facts
+    inner join mapping
+        on
+            facts.tag = mapping.tag
+            and facts.unit_of_measure = mapping.unit_of_measure
+
+),
+
+deduped as (
+
+    select *
+    from mapped
+    where concept_rank = 1
+
+),
+
+pivoted as (
+
+    select
+        filing_id,
+        company_id,
+        period_end_date,
+        duration_quarters,
+        period_type,
+        {{ pivot_concepts(concepts, with_source_tag=['revenue', 'net_income']) }}
+    from deduped
+    group by
+        filing_id,
+        company_id,
+        period_end_date,
+        duration_quarters,
+        period_type
+
+),
+
+flagged as (
+
+    select
+        *,
+        gross_profit is null
+        and revenue is not null
+        and cost_of_revenue is not null as is_gross_profit_derived
+    from pivoted
+
+)
+
+select
+    {{ dbt_utils.generate_surrogate_key(['filing_id', 'duration_quarters']) }} as income_statement_key,
+    filing_id,
+    company_id,
+    period_end_date,
+    duration_quarters,
+    period_type,
+    revenue,
+    revenue_tag,
+    cost_of_revenue,
+    -- Derive gross profit when the filer did not tag it explicitly. Many do not.
+    coalesce(gross_profit, revenue - cost_of_revenue) as gross_profit,
+    is_gross_profit_derived,
+    operating_expenses,
+    research_and_development,
+    sga_expense,
+    operating_income,
+    interest_expense,
+    pretax_income,
+    income_tax_expense,
+    net_income,
+    net_income_tag,
+    eps_basic,
+    eps_diluted
+from flagged
diff --git a/models/intermediate/int_filings__deduplicated.sql b/models/intermediate/int_filings__deduplicated.sql
new file mode 100644
index 0000000..b230430
--- /dev/null
+++ b/models/intermediate/int_filings__deduplicated.sql
@@ -0,0 +1,99 @@
+/*
+    One authoritative filing per (company, period end date, base form type).
+
+    A 10-K followed by a 10-K/A is two filings for the same fiscal year. This
+    model resolves them to one, without deleting either: mart_restatements reads
+    the superseded filings directly to compare them.
+
+    Resolution rules:
+
+    1. Only filings that contain a primary financial statement compete. A
+       "Part III" 10-K/A (filed to add executive-compensation disclosures) has
+       no statements at all; letting it win would erase the company's numbers
+       for that year.
+    2. Among those, the most recently FILED wins. Filed date, not period date,
+       because an amendment shares its original's period.
+    3. Deterministic tiebreaks (acceptance time, then accession number) so the
+       same input always produces the same output.
+
+    The SEC's prevrpt flag ("subsequently amended") is deliberately NOT used to
+    exclude filings: it is also set when the only amendment is a Part III
+    amendment, so filtering on it would drop the one filing that has numbers.
+
+    Scope: domestic periodic reports (10-K, 10-Q and their amendments).
+    Transition reports (10-KT) and foreign filers (20-F, 40-F, 6-K) are out of
+    scope for the financial marts but remain in dim_filing.
+*/
+
+with submissions as (
+
+    select * from {{ ref('stg_sec__submissions') }}
+    where base_form_type in ('10-K', '10-Q')
+
+),
+
+statement_lines as (
+
+    select
+        filing_id,
+        count(*) as primary_statement_line_count
+    from {{ ref('stg_sec__presentation') }}
+    where
+        statement_code in {{ primary_statement_codes() }}
+        and not is_parenthetical
+    group by filing_id
+
+),
+
+ranked as (
+
+    select
+        submissions.filing_id,
+        submissions.company_id,
+        submissions.period_end_date,
+        submissions.base_form_type,
+        submissions.form_type,
+        submissions.is_amendment,
+        submissions.fiscal_year,
+        submissions.fiscal_period,
+        submissions.filed_date,
+        submissions.accepted_at,
+        statement_lines.primary_statement_line_count,
+        count(*) over (
+            partition by
+                submissions.company_id,
+                submissions.period_end_date,
+                submissions.base_form_type
+        ) as competing_filing_count,
+        row_number() over (
+            partition by
+                submissions.company_id,
+                submissions.period_end_date,
+                submissions.base_form_type
+            order by
+                submissions.filed_date desc,
+                submissions.accepted_at desc,
+                submissions.filing_id desc
+        ) as filing_rank
+
+    from submissions
+    inner join statement_lines
+        on submissions.filing_id = statement_lines.filing_id
+
+)
+
+select
+    filing_id,
+    company_id,
+    period_end_date,
+    base_form_type,
+    form_type,
+    is_amendment,
+    fiscal_year,
+    fiscal_period,
+    filed_date,
+    accepted_at,
+    primary_statement_line_count,
+    competing_filing_count > 1 as has_superseded_filings
+from ranked
+where filing_rank = 1
diff --git a/models/intermediate/int_financials__annual.sql b/models/intermediate/int_financials__annual.sql
new file mode 100644
index 0000000..1cd0036
--- /dev/null
+++ b/models/intermediate/int_financials__annual.sql
@@ -0,0 +1,111 @@
+/*
+    Income statement, balance sheet and cash flow joined into one row per
+    company and fiscal year, from each year's authoritative 10-K (or 10-K/A).
+
+    Grain: one row per (company_id, fiscal_year).
+
+    All three statements come from the same filing, joined on filing_id. The
+    duration filter on each side (4 quarters for flows, the single balance
+    sheet per filing) is what prevents fan-out: joining on company and period
+    alone would multiply each year by the number of durations present.
+
+    If a company files two 10-Ks labelled with the same fiscal year (a change
+    of fiscal year end), the later period wins so the grain holds.
+*/
+
+with annual_filings as (
+
+    select *
+    from {{ ref('int_filings__deduplicated') }}
+    where base_form_type = '10-K'
+
+),
+
+income as (
+
+    select *
+    from {{ ref('int_facts__income_statement') }}
+    where duration_quarters = 4
+
+),
+
+balance as (
+
+    select * from {{ ref('int_facts__balance_sheet') }}
+
+),
+
+cash_flow as (
+
+    select *
+    from {{ ref('int_facts__cash_flow') }}
+    where duration_quarters = 4
+
+),
+
+joined as (
+
+    select
+        annual_filings.company_id,
+        annual_filings.fiscal_year,
+        annual_filings.period_end_date as fiscal_year_end_date,
+        annual_filings.filing_id as source_filing_id,
+        annual_filings.form_type as source_form_type,
+        annual_filings.is_amendment as is_from_amendment,
+        annual_filings.filed_date,
+        annual_filings.accepted_at,
+
+        income.revenue,
+        income.revenue_tag,
+        income.cost_of_revenue,
+        income.gross_profit,
+        income.operating_expenses,
+        income.research_and_development,
+        income.sga_expense,
+        income.operating_income,
+        income.interest_expense,
+        income.pretax_income,
+        income.income_tax_expense,
+        income.net_income,
+        income.net_income_tag,
+        income.eps_basic,
+        income.eps_diluted,
+
+        balance.cash_and_equivalents,
+        balance.short_term_investments,
+        balance.accounts_receivable,
+        balance.inventory,
+        balance.total_current_assets,
+        balance.total_assets,
+        balance.total_current_liabilities,
+        balance.total_liabilities,
+        balance.total_debt,
+        balance.total_equity,
+
+        cash_flow.operating_cash_flow,
+        cash_flow.investing_cash_flow,
+        cash_flow.financing_cash_flow,
+        cash_flow.capital_expenditure,
+        cash_flow.free_cash_flow,
+        cash_flow.dividends_paid,
+        cash_flow.share_repurchases,
+
+        income.filing_id is not null as has_income_statement,
+        balance.filing_id is not null as has_balance_sheet,
+        cash_flow.filing_id is not null as has_cash_flow
+
+    from annual_filings
+    left join income
+        on annual_filings.filing_id = income.filing_id
+    left join balance
+        on annual_filings.filing_id = balance.filing_id
+    left join cash_flow
+        on annual_filings.filing_id = cash_flow.filing_id
+
+)
+
+select * from joined
+qualify row_number() over (
+    partition by company_id, fiscal_year
+    order by fiscal_year_end_date desc, filed_date desc, source_filing_id desc
+) = 1
diff --git a/models/intermediate/int_financials__quarterly.sql b/models/intermediate/int_financials__quarterly.sql
new file mode 100644
index 0000000..1112cc4
--- /dev/null
+++ b/models/intermediate/int_financials__quarterly.sql
@@ -0,0 +1,155 @@
+/*
+    Quarterly income statement figures, with Q4 derived.
+
+    Grain: one row per (company_id, fiscal_year, fiscal_quarter).
+
+    There is no Q4 10-Q: a company files three 10-Qs and one 10-K, and the
+    10-K covers the full year. So Q4 is computed for FLOW measures:
+
+        Q4 = annual - Q1 - Q2 - Q3
+
+    Safeguards:
+    * Q4 is derived only when all three quarters were reported for that fiscal
+      year, and per measure only when all three quarters have that measure.
+      Deriving from two quarters would produce a confidently wrong number.
+    * Per-share figures are never derived: EPS is not additive across quarters
+      (share counts change), so derived-Q4 EPS is NULL.
+    * is_derived_q4 marks every computed row.
+
+    Q4 inherits any restatement made between the 10-Qs and the 10-K. That is a
+    real limitation of the arithmetic, not a bug; see docs/MODELING.md.
+*/
+
+{% set flow_measures = ['revenue', 'cost_of_revenue', 'gross_profit', 'operating_income', 'net_income'] %}
+{# Explicit, shared column list for the UNION ALL: never rely on select * order. #}
+{% set union_columns = ['company_id', 'fiscal_year', 'fiscal_quarter', 'period_end_date', 'source_filing_id']
+    + flow_measures + ['eps_basic', 'eps_diluted'] %}
+
+with quarterly_filings as (
+
+    select
+        filing_id,
+        company_id,
+        fiscal_year,
+        period_end_date,
+        case fiscal_period
+            when 'Q1' then 1
+            when 'Q2' then 2
+            when 'Q3' then 3
+        end as fiscal_quarter,
+        filed_date
+    from {{ ref('int_filings__deduplicated') }}
+    where
+        base_form_type = '10-Q'
+        and fiscal_period in ('Q1', 'Q2', 'Q3')
+
+),
+
+reported as (
+
+    select
+        quarterly_filings.company_id,
+        quarterly_filings.fiscal_year,
+        quarterly_filings.fiscal_quarter,
+        quarterly_filings.period_end_date,
+        quarterly_filings.filing_id as source_filing_id,
+        {% for measure in flow_measures %}
+        income.{{ measure }},
+        {% endfor %}
+        income.eps_basic,
+        income.eps_diluted
+    from quarterly_filings
+    inner join {{ ref('int_facts__income_statement') }} as income
+        on
+            quarterly_filings.filing_id = income.filing_id
+            and income.duration_quarters = 1
+    qualify row_number() over (
+        partition by
+            quarterly_filings.company_id,
+            quarterly_filings.fiscal_year,
+            quarterly_filings.fiscal_quarter
+        order by quarterly_filings.period_end_date desc, quarterly_filings.filed_date desc
+    ) = 1
+
+),
+
+quarter_totals as (
+
+    select
+        company_id,
+        fiscal_year,
+        {% for measure in flow_measures %}
+        count({{ measure }}) as {{ measure }}_quarters,
+        sum({{ measure }}) as {{ measure }}_q1_to_q3,
+        {% endfor %}
+        count(*) as quarters_reported
+    from reported
+    group by company_id, fiscal_year
+
+),
+
+derived_q4 as (
+
+    select
+        annual.company_id,
+        annual.fiscal_year,
+        4 as fiscal_quarter,
+        annual.fiscal_year_end_date as period_end_date,
+        annual.source_filing_id,
+        {% for measure in flow_measures %}
+        case
+            when quarter_totals.{{ measure }}_quarters = 3
+                then annual.{{ measure }} - quarter_totals.{{ measure }}_q1_to_q3
+        end as {{ measure }},
+        {% endfor %}
+        cast(null as decimal(28, 4)) as eps_basic,
+        cast(null as decimal(28, 4)) as eps_diluted
+    from {{ ref('int_financials__annual') }} as annual
+    inner join quarter_totals
+        on
+            annual.company_id = quarter_totals.company_id
+            and annual.fiscal_year = quarter_totals.fiscal_year
+    where quarter_totals.quarters_reported = 3
+
+),
+
+unioned as (
+
+    select
+        {% for column in union_columns %}
+        {{ column }},
+        {% endfor %}
+        false as is_derived_q4
+    from reported
+
+    union all
+
+    select
+        {% for column in union_columns %}
+        {{ column }},
+        {% endfor %}
+        true as is_derived_q4
+    from derived_q4
+
+)
+
+select
+    {{ dbt_utils.generate_surrogate_key(['unioned.company_id', 'unioned.fiscal_year', 'unioned.fiscal_quarter']) }}
+        as quarterly_financials_key,
+    unioned.company_id,
+    unioned.fiscal_year,
+    unioned.fiscal_quarter,
+    unioned.period_end_date,
+    unioned.source_filing_id,
+    {% for measure in flow_measures %}
+    unioned.{{ measure }},
+    {% endfor %}
+    unioned.eps_basic,
+    unioned.eps_diluted,
+    unioned.is_derived_q4,
+    coalesce(quarter_totals.quarters_reported = 3, false) as has_complete_quarters
+from unioned
+left join quarter_totals
+    on
+        unioned.company_id = quarter_totals.company_id
+        and unioned.fiscal_year = quarter_totals.fiscal_year
diff --git a/models/marts/core/_core__models.yml b/models/marts/core/_core__models.yml
new file mode 100644
index 0000000..a078c34
--- /dev/null
+++ b/models/marts/core/_core__models.yml
@@ -0,0 +1,289 @@
+version: 2
+
+models:
+  - name: dim_company
+    description: >
+      Company dimension with current attributes (Type 1). One row per company.
+      For attributes as of a past date, use dim_company_history.
+    columns:
+      - name: company_key
+        description: Surrogate key (hash of CIK). Join target for facts.
+        data_type: varchar
+        data_tests: [not_null, unique]
+      - name: cik
+        description: SEC Central Index Key, the company's natural key.
+        data_type: bigint
+        data_tests: [not_null, unique]
+      - name: cik_padded
+        description: CIK as the 10-digit zero-padded string EDGAR URLs use.
+        data_type: varchar
+      - name: company_name
+        description: Current conformed company name.
+        data_type: varchar
+      - name: sic_code
+        description: Current four-digit SIC code.
+        data_type: integer
+      - name: sector
+        description: SIC division of the current SIC code, or 'Unclassified'.
+        data_type: varchar
+      - name: industry_group
+        description: SIC major group of the current SIC code, or 'Unclassified'.
+        data_type: varchar
+      - name: incorporation_state_code
+        description: State of incorporation (US/CA).
+        data_type: varchar
+      - name: incorporation_country_code
+        description: Country of incorporation.
+        data_type: varchar
+      - name: fiscal_year_end_mmdd
+        description: Fiscal year end as MMDD.
+        data_type: varchar
+      - name: first_filed_date
+        description: Earliest filing date loaded for the company.
+        data_type: date
+      - name: latest_filed_date
+        description: Most recent filing date loaded for the company.
+        data_type: date
+      - name: filing_count
+        description: Number of filings loaded for the company (all forms).
+        data_type: bigint
+      - name: attribute_version_count
+        description: Number of SCD2 versions in dim_company_history.
+        data_type: bigint
+
+  - name: dim_company_history
+    description: >
+      Company attributes over time (SCD Type 2), derived from the attributes
+      recorded on every filing. One row per company per attribute version;
+      valid_from inclusive, valid_to exclusive, current version valid_to NULL.
+    columns:
+      - name: company_history_key
+        description: Surrogate key (hash of CIK and valid_from).
+        data_type: varchar
+        data_tests: [not_null, unique]
+      - name: company_key
+        description: Key of the company in dim_company.
+        data_type: varchar
+        data_tests:
+          - not_null
+          - relationships:
+              arguments:
+                to: ref('dim_company')
+                field: company_key
+      - name: cik
+        description: SEC Central Index Key.
+        data_type: bigint
+        data_tests:
+          - not_null
+          # Exactly one current version per company.
+          - unique:
+              config:
+                where: "is_current"
+      - name: version_number
+        description: 1 for the earliest version, incrementing with each change.
+        data_type: bigint
+      - name: company_name
+        description: Company name during this version.
+        data_type: varchar
+      - name: sic_code
+        description: SIC code during this version.
+        data_type: integer
+      - name: sector
+        description: SIC division during this version.
+        data_type: varchar
+      - name: industry_group
+        description: SIC major group during this version.
+        data_type: varchar
+      - name: incorporation_state_code
+        description: State of incorporation during this version.
+        data_type: varchar
+      - name: incorporation_country_code
+        description: Country of incorporation during this version.
+        data_type: varchar
+      - name: fiscal_year_end_mmdd
+        description: Fiscal year end during this version.
+        data_type: varchar
+      - name: valid_from
+        description: Acceptance time of the first filing showing this version (inclusive).
+        data_type: timestamp
+        data_tests: [not_null]
+      - name: valid_to
+        description: Start of the next version (exclusive). NULL for the current version.
+        data_type: timestamp
+      - name: is_current
+        description: True for the latest version.
+        data_type: boolean
+      - name: first_filed_date
+        description: First filing date within this version.
+        data_type: date
+      - name: last_filed_date
+        description: Last filing date within this version.
+        data_type: date
+      - name: filing_count
+        description: Filings within this version.
+        data_type: bigint
+
+  - name: dim_filing
+    description: >
+      Every SEC submission loaded, including amendments and out-of-scope forms.
+      One row per filing.
+    data_tests:
+      - dbt_utils.equal_rowcount:
+          arguments:
+            compare_model: ref('stg_sec__submissions')
+    columns:
+      - name: filing_key
+        description: Surrogate key (hash of accession number).
+        data_type: varchar
+        data_tests: [not_null, unique]
+      - name: company_key
+        description: Key of the filing company in dim_company.
+        data_type: varchar
+        data_tests:
+          - relationships:
+              arguments:
+                to: ref('dim_company')
+                field: company_key
+      - name: filing_id
+        description: SEC accession number.
+        data_type: varchar
+        data_tests: [not_null, unique]
+      - name: cik
+        description: Filer's CIK.
+        data_type: bigint
+      - name: form_type
+        description: Submission type, e.g. 10-K, 10-K/A, 20-F.
+        data_type: varchar
+      - name: base_form_type
+        description: Form type without the /A suffix.
+        data_type: varchar
+      - name: is_amendment
+        description: True for an amendment (/A).
+        data_type: boolean
+      - name: period_end_date
+        description: Period the filing reports on.
+        data_type: date
+      - name: fiscal_year
+        description: Fiscal year focus.
+        data_type: integer
+      - name: fiscal_period
+        description: Fiscal period focus (FY, Q1-Q4).
+        data_type: varchar
+      - name: filed_date
+        description: Filing date.
+        data_type: date
+      - name: accepted_at
+        description: EDGAR acceptance timestamp (US Eastern).
+        data_type: timestamp
+      - name: days_to_file
+        description: Days from period end to filing date.
+        data_type: bigint
+      - name: has_financial_statements
+        description: True if the filing presents a balance sheet, income statement or cash flow statement.
+        data_type: boolean
+      - name: is_authoritative
+        description: True if this filing is the one used in the financial marts for its company-period.
+        data_type: boolean
+      - name: is_subsequently_amended
+        description: SEC prevrpt flag.
+        data_type: boolean
+      - name: source_quarter
+        description: SEC data set quarter the filing was loaded from.
+        data_type: varchar
+
+  - name: fct_financial_facts
+    description: >
+      Atomic fact table: every numeric fact loaded, at the SEC's eight-column
+      grain, including custom tags, segments and co-registrants. Incremental on
+      load time. One row per fact.
+    data_tests:
+      # Reconciliation: every staged fact is here exactly once. Fails if rows
+      # were missed, duplicated, or left behind after a source deletion
+      # (fix with --full-refresh).
+      - dbt_utils.equal_rowcount:
+          arguments:
+            compare_model: ref('stg_sec__numeric_facts')
+    columns:
+      - name: fact_key
+        description: Hash of the eight grain columns. Merge key.
+        data_type: varchar
+        data_tests: [not_null, unique]
+      - name: filing_key
+        description: Key of the filing in dim_filing.
+        data_type: varchar
+        data_tests:
+          - not_null
+          - relationships:
+              arguments:
+                to: ref('dim_filing')
+                field: filing_key
+      - name: company_key
+        description: Key of the company in dim_company.
+        data_type: varchar
+        data_tests:
+          - not_null
+          - relationships:
+              arguments:
+                to: ref('dim_company')
+                field: company_key
+      - name: filing_id
+        description: SEC accession number.
+        data_type: varchar
+      - name: cik
+        description: Filer's CIK.
+        data_type: bigint
+      - name: tag
+        description: XBRL element name.
+        data_type: varchar
+      - name: tag_version
+        description: Taxonomy version, or the accession number for custom tags.
+        data_type: varchar
+      - name: period_end_date
+        description: End date of the value (month-end rounded by the SEC).
+        data_type: date
+      - name: duration_quarters
+        description: Quarters covered; 0 = point in time.
+        data_type: integer
+      - name: unit_of_measure
+        description: Unit, e.g. USD or USD/shares.
+        data_type: varchar
+      - name: segments
+        description: Axis/member breakdown; NULL for the consolidated figure.
+        data_type: varchar
+      - name: coregistrant
+        description: Co-registrant; NULL for the consolidated registrant.
+        data_type: varchar
+      - name: is_consolidated
+        description: True when neither segments nor a co-registrant is set.
+        data_type: boolean
+      - name: fact_value
+        description: Value; NULL for nil or unparseable source values.
+        data_type: decimal(28,4)
+      - name: source_quarter
+        description: SEC data set quarter the fact was loaded from.
+        data_type: varchar
+      - name: loaded_at
+        description: Load timestamp; the incremental watermark.
+        data_type: timestamp
+
+unit_tests:
+  - name: test_company_history_gaps_and_islands
+    description: >
+      A -> B -> A must produce three versions, not two; dates chain without
+      gaps or overlaps; only the last version is current.
+    model: dim_company_history
+    given:
+      - input: ref('stg_sec__submissions')
+        rows:
+          - {company_id: 1, filing_id: "f1", accepted_at: "2023-01-10 16:00:00", filed_date: 2023-01-10, company_name: "ACME A", sic_code: 7372, incorporation_state_code: "DE", incorporation_country_code: "US", fiscal_year_end_mmdd: "1231"}
+          - {company_id: 1, filing_id: "f2", accepted_at: "2023-04-10 16:00:00", filed_date: 2023-04-10, company_name: "ACME A", sic_code: 7372, incorporation_state_code: "DE", incorporation_country_code: "US", fiscal_year_end_mmdd: "1231"}
+          - {company_id: 1, filing_id: "f3", accepted_at: "2023-07-10 16:00:00", filed_date: 2023-07-10, company_name: "ACME B", sic_code: 7372, incorporation_state_code: "DE", incorporation_country_code: "US", fiscal_year_end_mmdd: "1231"}
+          - {company_id: 1, filing_id: "f4", accepted_at: "2023-10-10 16:00:00", filed_date: 2023-10-10, company_name: "ACME A", sic_code: 7372, incorporation_state_code: "DE", incorporation_country_code: "US", fiscal_year_end_mmdd: "1231"}
+      - input: ref('sic_sector_mapping')
+        rows:
+          - {sic_low: 7300, sic_high: 7399, sector: "Services", industry_group: "Business Services"}
+    expect:
+      rows:
+        - {cik: 1, version_number: 1, company_name: "ACME A", sector: "Services", valid_from: "2023-01-10 16:00:00", valid_to: "2023-07-10 16:00:00", is_current: false, filing_count: 2}
+        - {cik: 1, version_number: 2, company_name: "ACME B", sector: "Services", valid_from: "2023-07-10 16:00:00", valid_to: "2023-10-10 16:00:00", is_current: false, filing_count: 1}
+        - {cik: 1, version_number: 3, company_name: "ACME A", sector: "Services", valid_from: "2023-10-10 16:00:00", valid_to: null, is_current: true, filing_count: 1}
diff --git a/models/marts/core/dim_company.sql b/models/marts/core/dim_company.sql
new file mode 100644
index 0000000..c2a7634
--- /dev/null
+++ b/models/marts/core/dim_company.sql
@@ -0,0 +1,45 @@
+/*
+    Company dimension: current attributes (Type 1 view of dim_company_history).
+
+    Grain: one row per company (CIK). For attributes as they were at a past
+    date, join dim_company_history instead.
+*/
+
+with current_version as (
+
+    select * from {{ ref('dim_company_history') }}
+    where is_current
+
+),
+
+filing_stats as (
+
+    select
+        cik,
+        min(first_filed_date) as first_filed_date,
+        max(last_filed_date) as latest_filed_date,
+        sum(filing_count) as filing_count,
+        count(*) as attribute_version_count
+    from {{ ref('dim_company_history') }}
+    group by cik
+
+)
+
+select
+    current_version.company_key,
+    current_version.cik,
+    lpad(cast(current_version.cik as varchar), 10, '0') as cik_padded,
+    current_version.company_name,
+    current_version.sic_code,
+    current_version.sector,
+    current_version.industry_group,
+    current_version.incorporation_state_code,
+    current_version.incorporation_country_code,
+    current_version.fiscal_year_end_mmdd,
+    filing_stats.first_filed_date,
+    filing_stats.latest_filed_date,
+    filing_stats.filing_count,
+    filing_stats.attribute_version_count
+from current_version
+inner join filing_stats
+    on current_version.cik = filing_stats.cik
diff --git a/models/marts/core/dim_company_history.sql b/models/marts/core/dim_company_history.sql
new file mode 100644
index 0000000..2e8e02e
--- /dev/null
+++ b/models/marts/core/dim_company_history.sql
@@ -0,0 +1,130 @@
+/*
+    Company attributes over time: Slowly Changing Dimension Type 2.
+
+    Grain: one row per company per version of its tracked attributes (name, SIC
+    code, state and country of incorporation, fiscal year end).
+
+    Why a model and not a dbt snapshot: a snapshot records when WE noticed a
+    change, and its history is lost if the snapshot table is ever rebuilt. Here
+    the history is already in the source -- every filing records the company's
+    attributes as of that filing -- so versions are derived from the data:
+    effective dates are the acceptance time of the first filing that showed
+    them, the model is fully reproducible, and a backfill of older quarters
+    corrects history instead of being appended out of order.
+
+    Gaps-and-islands: a new version starts whenever the attribute set differs
+    from the previous filing's. A company that changes A -> B -> A gets three
+    versions, not two (grouping by the attributes alone would merge the A's).
+
+    valid_from is inclusive, valid_to exclusive; the current version has
+    valid_to NULL and is_current true. Point-in-time join:
+        filing.accepted_at >= valid_from
+        and (filing.accepted_at < valid_to or valid_to is null)
+
+    Surrogate keys are deterministic for a given set of loaded filings. A
+    backfill can move a version's valid_from, so only fully rebuilt tables
+    store company_history_key (never the incremental fct_financial_facts).
+*/
+
+with filings as (
+
+    select
+        company_id,
+        filing_id,
+        accepted_at,
+        filed_date,
+        company_name,
+        sic_code,
+        incorporation_state_code,
+        incorporation_country_code,
+        fiscal_year_end_mmdd,
+        {{ dbt_utils.generate_surrogate_key([
+            'company_name', 'sic_code', 'incorporation_state_code',
+            'incorporation_country_code', 'fiscal_year_end_mmdd'
+        ]) }} as attribute_hash
+    from {{ ref('stg_sec__submissions') }}
+
+),
+
+flagged as (
+
+    select
+        *,
+        case
+            when attribute_hash = lag(attribute_hash) over (
+                partition by company_id order by accepted_at, filing_id
+            ) then 0
+            else 1
+        end as starts_new_version
+    from filings
+
+),
+
+numbered as (
+
+    select
+        *,
+        sum(starts_new_version) over (
+            partition by company_id
+            order by accepted_at, filing_id
+            rows between unbounded preceding and current row
+        ) as version_number
+    from flagged
+
+),
+
+versions as (
+
+    -- Attributes are constant within a version by construction, so any
+    -- aggregate returns the same value; min() just collapses the rows.
+    select
+        company_id,
+        version_number,
+        min(company_name) as company_name,
+        min(sic_code) as sic_code,
+        min(incorporation_state_code) as incorporation_state_code,
+        min(incorporation_country_code) as incorporation_country_code,
+        min(fiscal_year_end_mmdd) as fiscal_year_end_mmdd,
+        min(accepted_at) as valid_from,
+        min(filed_date) as first_filed_date,
+        max(filed_date) as last_filed_date,
+        count(*) as filing_count
+    from numbered
+    group by company_id, version_number
+
+),
+
+sectors as (
+
+    select * from {{ ref('sic_sector_mapping') }}
+
+)
+
+select
+    {{ dbt_utils.generate_surrogate_key(['versions.company_id', 'versions.valid_from']) }}
+        as company_history_key,
+    {{ dbt_utils.generate_surrogate_key(['versions.company_id']) }} as company_key,
+    versions.company_id as cik,
+    versions.version_number,
+    versions.company_name,
+    versions.sic_code,
+    coalesce(sectors.sector, 'Unclassified') as sector,
+    coalesce(sectors.industry_group, 'Unclassified') as industry_group,
+    versions.incorporation_state_code,
+    versions.incorporation_country_code,
+    versions.fiscal_year_end_mmdd,
+    versions.valid_from,
+    lead(versions.valid_from) over (
+        partition by versions.company_id order by versions.version_number
+    ) as valid_to,
+    lead(versions.valid_from) over (
+        partition by versions.company_id order by versions.version_number
+    ) is null as is_current,
+    versions.first_filed_date,
+    versions.last_filed_date,
+    versions.filing_count
+from versions
+-- Range join. Safe only because assert_sic_ranges_do_not_overlap guarantees at
+-- most one matching range; the unique test on company_history_key backs it up.
+left join sectors
+    on versions.sic_code between sectors.sic_low and sectors.sic_high
diff --git a/models/marts/core/dim_filing.sql b/models/marts/core/dim_filing.sql
new file mode 100644
index 0000000..37ded5b
--- /dev/null
+++ b/models/marts/core/dim_filing.sql
@@ -0,0 +1,59 @@
+/*
+    Filing dimension: every submission, including amendments and forms outside
+    the financial marts' scope (20-F, 40-F, ...).
+
+    Grain: one row per filing (accession number).
+
+    is_authoritative marks the filing int_filings__deduplicated chose for its
+    company-period. days_to_file measures reporting lag from period end.
+*/
+
+with submissions as (
+
+    select * from {{ ref('stg_sec__submissions') }}
+
+),
+
+statement_filings as (
+
+    select distinct filing_id
+    from {{ ref('stg_sec__presentation') }}
+    where
+        statement_code in {{ primary_statement_codes() }}
+        and not is_parenthetical
+
+),
+
+authoritative as (
+
+    select filing_id from {{ ref('int_filings__deduplicated') }}
+
+)
+
+select
+    {{ dbt_utils.generate_surrogate_key(['submissions.filing_id']) }} as filing_key,
+    {{ dbt_utils.generate_surrogate_key(['submissions.company_id']) }} as company_key,
+    submissions.filing_id,
+    submissions.company_id as cik,
+    submissions.form_type,
+    submissions.base_form_type,
+    submissions.is_amendment,
+    submissions.period_end_date,
+    submissions.fiscal_year,
+    submissions.fiscal_period,
+    submissions.filed_date,
+    submissions.accepted_at,
+    {{ dbt.datediff(
+        'submissions.period_end_date',
+        'submissions.filed_date',
+        'day'
+    ) }} as days_to_file,
+    statement_filings.filing_id is not null as has_financial_statements,
+    authoritative.filing_id is not null as is_authoritative,
+    submissions.is_subsequently_amended,
+    submissions.source_quarter
+from submissions
+left join statement_filings
+    on submissions.filing_id = statement_filings.filing_id
+left join authoritative
+    on submissions.filing_id = authoritative.filing_id
diff --git a/models/marts/core/fct_financial_facts.sql b/models/marts/core/fct_financial_facts.sql
new file mode 100644
index 0000000..aa92bf8
--- /dev/null
+++ b/models/marts/core/fct_financial_facts.sql
@@ -0,0 +1,80 @@
+{{
+    config(
+        materialized='incremental',
+        unique_key='fact_key',
+        incremental_strategy=('merge' if target.type == 'snowflake' else 'delete+insert'),
+        on_schema_change='append_new_columns'
+    )
+}}
+
+/*
+    Atomic fact table: every numeric fact ever loaded, at the SEC's native
+    grain, including custom tags, segment rows and co-registrant rows.
+
+    Grain: one row per fact_key.
+
+    The only incremental model in the project, because it is the only one where
+    a full rebuild is genuinely expensive (tens of millions of rows across the
+    full SEC history).
+
+    Watermark: LOAD time (loaded_at), not filed_date. The SEC files are loaded
+    a quarter at a time, and a backfill of an older quarter loads filings whose
+    filed_date is years older than anything already in the table -- a filed_date
+    filter would skip every one of them. loaded_at always moves forward. A
+    lookback window (incremental_lookback_hours) absorbs loads that commit out
+    of order; reprocessing that overlap is a no-op because of unique_key.
+
+    Strategy: merge on Snowflake; delete+insert on DuckDB (local/CI). Both
+    upsert on fact_key, so a reloaded quarter replaces its rows.
+
+    Hard deletes: if a reloaded quarter no longer contains a fact, the old row
+    stays here. The equal_rowcount test against stg_sec__numeric_facts detects
+    that; the fix is `dbt build --full-refresh --select fct_financial_facts`.
+
+    Only immutable attributes are stored. Mutable ones (is the filing still
+    authoritative? the company's current name?) live in the dimensions, so a
+    later amendment can never leave a stale flag in an old incremental row.
+*/
+
+with facts as (
+
+    select * from {{ ref('stg_sec__numeric_facts') }}
+    {% if is_incremental() %}
+    where
+        loaded_at > (
+            select {{ dbt.dateadd('hour', -1 * var('incremental_lookback_hours'), 'max(loaded_at)') }}
+            from {{ this }}
+        )
+    {% endif %}
+
+),
+
+filings as (
+
+    select
+        filing_id,
+        company_id
+    from {{ ref('stg_sec__submissions') }}
+
+)
+
+select
+    facts.fact_key,
+    {{ dbt_utils.generate_surrogate_key(['facts.filing_id']) }} as filing_key,
+    {{ dbt_utils.generate_surrogate_key(['filings.company_id']) }} as company_key,
+    facts.filing_id,
+    filings.company_id as cik,
+    facts.tag,
+    facts.tag_version,
+    facts.period_end_date,
+    facts.duration_quarters,
+    facts.unit_of_measure,
+    facts.segments,
+    facts.coregistrant,
+    facts.is_consolidated,
+    facts.fact_value,
+    facts.source_quarter,
+    facts.loaded_at
+from facts
+inner join filings
+    on facts.filing_id = filings.filing_id
diff --git a/models/marts/finance/_finance__models.yml b/models/marts/finance/_finance__models.yml
new file mode 100644
index 0000000..5a3f631
--- /dev/null
+++ b/models/marts/finance/_finance__models.yml
@@ -0,0 +1,696 @@
+version: 2
+
+models:
+  - name: fct_company_financials_annual
+    description: >
+      Primary analytical table. One row per company per fiscal year: income
+      statement, balance sheet and cash flow from that year's authoritative 10-K
+      (or 10-K/A). Sector is point-in-time (as of the filing). NULL means not
+      reported, never zero.
+    data_tests:
+      - dbt_utils.unique_combination_of_columns:
+          arguments:
+            combination_of_columns: ["cik", "fiscal_year"]
+      # No fan-out and no dropped rows from the dimension joins.
+      - dbt_utils.equal_rowcount:
+          arguments:
+            compare_model: ref('int_financials__annual')
+    columns:
+      - name: annual_financials_key
+        description: Surrogate key (hash of CIK and fiscal year).
+        data_type: varchar
+        data_tests: [not_null, unique]
+      - name: company_key
+        description: Key in dim_company.
+        data_type: varchar
+        data_tests:
+          - not_null
+          - relationships:
+              arguments:
+                to: ref('dim_company')
+                field: company_key
+      - name: company_history_key
+        description: Key of the dim_company_history version current when the 10-K was accepted.
+        data_type: varchar
+        data_tests:
+          - not_null
+          - relationships:
+              arguments:
+                to: ref('dim_company_history')
+                field: company_history_key
+      - name: filing_key
+        description: Key of the source filing in dim_filing.
+        data_type: varchar
+        data_tests:
+          - relationships:
+              arguments:
+                to: ref('dim_filing')
+                field: filing_key
+      - name: cik
+        description: SEC Central Index Key.
+        data_type: bigint
+      - name: company_name
+        description: Current company name.
+        data_type: varchar
+      - name: sector
+        description: SIC division as of the filing.
+        data_type: varchar
+      - name: industry_group
+        description: SIC major group as of the filing.
+        data_type: varchar
+      - name: fiscal_year
+        description: Fiscal year as labelled by the filer.
+        data_type: integer
+      - name: fiscal_year_end_date
+        description: Balance sheet date of the fiscal year.
+        data_type: date
+      - name: filed_date
+        description: Filing date of the source 10-K.
+        data_type: date
+      - name: source_filing_id
+        description: Accession number of the 10-K or 10-K/A all values came from.
+        data_type: varchar
+      - name: source_form_type
+        description: 10-K or 10-K/A.
+        data_type: varchar
+      - name: is_from_amendment
+        description: True when the authoritative filing is an amendment (restated figures).
+        data_type: boolean
+      - name: revenue
+        description: Total revenue. NULL if no mapped revenue tag was reported (not zero revenue).
+        data_type: decimal(28,4)
+        data_tests:
+          - not_null_proportion:
+              arguments:
+                at_least: 0.8
+              config:
+                severity: warn
+      - name: revenue_tag
+        description: XBRL tag that supplied revenue.
+        data_type: varchar
+      - name: cost_of_revenue
+        description: Cost of revenue / cost of goods sold.
+        data_type: decimal(28,4)
+      - name: gross_profit
+        description: Gross profit, reported or derived as revenue minus cost of revenue.
+        data_type: decimal(28,4)
+      - name: operating_expenses
+        description: Total operating expenses as reported.
+        data_type: decimal(28,4)
+      - name: research_and_development
+        description: R&D expense. NULL when not reported separately (common outside tech).
+        data_type: decimal(28,4)
+      - name: sga_expense
+        description: Selling, general and administrative expense.
+        data_type: decimal(28,4)
+      - name: operating_income
+        description: Operating income (loss).
+        data_type: decimal(28,4)
+      - name: interest_expense
+        description: Interest expense.
+        data_type: decimal(28,4)
+      - name: pretax_income
+        description: Income (loss) before income taxes.
+        data_type: decimal(28,4)
+      - name: income_tax_expense
+        description: Income tax expense (benefit).
+        data_type: decimal(28,4)
+      - name: net_income
+        description: Net income (loss) attributable to the parent.
+        data_type: decimal(28,4)
+      - name: net_income_tag
+        description: XBRL tag that supplied net income.
+        data_type: varchar
+      - name: eps_basic
+        description: Basic earnings per share (USD).
+        data_type: decimal(28,4)
+      - name: eps_diluted
+        description: Diluted earnings per share (USD).
+        data_type: decimal(28,4)
+      - name: cash_and_equivalents
+        description: Cash and cash equivalents at fiscal year end.
+        data_type: decimal(28,4)
+      - name: short_term_investments
+        description: Short-term investments / marketable securities.
+        data_type: decimal(28,4)
+      - name: accounts_receivable
+        description: Accounts receivable, net.
+        data_type: decimal(28,4)
+      - name: inventory
+        description: Inventory, net. NULL for most service businesses.
+        data_type: decimal(28,4)
+      - name: total_current_assets
+        description: Total current assets. NULL for unclassified balance sheets (e.g. banks).
+        data_type: decimal(28,4)
+      - name: total_assets
+        description: Total assets.
+        data_type: decimal(28,4)
+      - name: total_current_liabilities
+        description: Total current liabilities.
+        data_type: decimal(28,4)
+      - name: total_liabilities
+        description: Total liabilities (many filers do not report this subtotal).
+        data_type: decimal(28,4)
+      - name: total_debt
+        description: Current + short-term + non-current debt. NULL when no debt is tagged.
+        data_type: decimal(28,4)
+      - name: total_equity
+        description: Stockholders' equity attributable to the parent.
+        data_type: decimal(28,4)
+      - name: operating_cash_flow
+        description: Net cash from operating activities.
+        data_type: decimal(28,4)
+      - name: investing_cash_flow
+        description: Net cash from investing activities.
+        data_type: decimal(28,4)
+      - name: financing_cash_flow
+        description: Net cash from financing activities.
+        data_type: decimal(28,4)
+      - name: capital_expenditure
+        description: Payments for property, plant and equipment (positive).
+        data_type: decimal(28,4)
+      - name: free_cash_flow
+        description: Operating cash flow minus capital expenditure.
+        data_type: decimal(28,4)
+      - name: dividends_paid
+        description: Dividends paid.
+        data_type: decimal(28,4)
+      - name: share_repurchases
+        description: Payments for repurchase of common stock.
+        data_type: decimal(28,4)
+      - name: has_revenue
+        description: True when revenue is reported.
+        data_type: boolean
+      - name: has_income_statement
+        description: True when any income statement concept was found.
+        data_type: boolean
+      - name: has_balance_sheet
+        description: True when any balance sheet concept was found.
+        data_type: boolean
+      - name: has_cash_flow
+        description: True when any annual cash flow concept was found.
+        data_type: boolean
+      - name: balance_sheet_balances
+        description: >
+          Assets = liabilities + equity within var('balance_sheet_tolerance_pct')
+          of assets. NULL when a component is not reported.
+        data_type: boolean
+
+  - name: fct_financial_ratios
+    description: >
