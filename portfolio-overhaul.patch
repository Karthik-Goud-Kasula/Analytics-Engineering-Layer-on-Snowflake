-      - uses: actions/checkout@v4
-
-      - uses: actions/setup-python@v5
-        with:
-          python-version: "3.11"
-          cache: pip
-
-      - name: Install
-        run: pip install -r requirements.txt
-
-      - name: sqlfluff lint
-        run: sqlfluff lint models macros tests --dialect snowflake
-
-      - name: Check every model has a description
-        # A model with no documentation is a model nobody can safely reuse.
-        # Failing here is cheaper than discovering it six months later.
-        run: python scripts/check_model_documentation.py
-
-  build:
-    name: Slim CI build
-    runs-on: ubuntu-latest
-    needs: lint
-    steps:
-      - uses: actions/checkout@v4
-
-      - uses: actions/setup-python@v5
-        with:
-          python-version: "3.11"
-          cache: pip
-
-      - name: Install
-        run: pip install -r requirements.txt
-
-      - name: Write CI profile
-        run: |
-          mkdir -p ./ci
-          cat > ./ci/profiles.yml <<'PROFILE'
-          sec_analytics:
-            target: ci
-            outputs:
-              ci:
-                type: snowflake
-                account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
-                user: "{{ env_var('SNOWFLAKE_USER') }}"
-                private_key: "{{ env_var('SNOWFLAKE_PRIVATE_KEY') }}"
-                role: TRANSFORMER_CI
-                database: SEC_ANALYTICS_CI
-                warehouse: TRANSFORM_XS
-                schema: "pr_{{ env_var('DBT_CI_SCHEMA') }}"
-                threads: 12
-          PROFILE
-
-      - name: dbt deps
-        run: dbt deps
-
-      - name: Fetch production manifest
-        # Slim CI: the previous production manifest lets dbt build ONLY what
-        # changed plus its downstream dependents. On a 23-model project that is
-        # the difference between a 12-minute PR check and a 90-second one, and
-        # it is the single highest-leverage thing in this workflow.
-        continue-on-error: true
-        run: |
-          mkdir -p ./prod-artifacts
-          aws s3 cp s3://${{ secrets.DBT_ARTIFACT_BUCKET }}/manifest.json \
-            ./prod-artifacts/manifest.json || echo "No prior manifest; full build"
-        env:
-          AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
-          AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
-          AWS_DEFAULT_REGION: ${{ secrets.AWS_REGION }}
-
-      - name: dbt seed
-        run: dbt seed --target ci --full-refresh
-
-      - name: dbt build (state-aware)
-        run: |
-          if [ -f ./prod-artifacts/manifest.json ]; then
-            echo "Slim CI: building modified models and their children"
-            dbt build --target ci \
-              --select "state:modified+" \
-              --defer --state ./prod-artifacts \
-              --fail-fast
-          else
-            echo "No baseline manifest: full build"
-            dbt build --target ci --fail-fast
-          fi
-
-      - name: Report test failures
-        if: failure()
-        run: |
-          echo "### dbt test failures" >> $GITHUB_STEP_SUMMARY
-          echo '```' >> $GITHUB_STEP_SUMMARY
-          tail -n 60 logs/dbt.log >> $GITHUB_STEP_SUMMARY || true
-          echo '```' >> $GITHUB_STEP_SUMMARY
-
-      - name: Upload run artifacts
-        if: always()
-        uses: actions/upload-artifact@v4
-        with:
-          name: dbt-ci-artifacts-pr-${{ github.event.pull_request.number }}
-          path: |
-            target/manifest.json
-            target/run_results.json
-            logs/dbt.log
-          retention-days: 14
-
-      - name: Drop the PR schema
-        # Runs even on failure. Without this, every merged PR leaves an orphaned
-        # schema behind and the CI database grows without bound.
-        if: always()
-        run: |
-          dbt run-operation drop_pr_schemas --target ci \
-            --args "{schema_prefix: pr_${{ github.event.pull_request.number }}}" || true
