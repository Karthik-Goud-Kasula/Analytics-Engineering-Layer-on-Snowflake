+++ b/macros/parse_yyyymmdd.sql
@@ -0,0 +1,24 @@
+{#
+    Parse a YYYYMMDD string (the SEC's date format) into a DATE.
+    Returns NULL instead of failing on a malformed value; staging tests then
+    report how many dates did not parse.
+
+    Dispatched because the two warehouses spell "try to parse" differently.
+#}
+{% macro parse_yyyymmdd(column) -%}
+    {{ return(adapter.dispatch('parse_yyyymmdd', 'sec_analytics')(column)) }}
+{%- endmacro %}
+
+{% macro snowflake__parse_yyyymmdd(column) -%}
+    try_to_date({{ column }}, 'YYYYMMDD')
+{%- endmacro %}
+
+{% macro duckdb__parse_yyyymmdd(column) -%}
+    cast(try_strptime({{ column }}, '%Y%m%d') as date)
+{%- endmacro %}
+
+{% macro default__parse_yyyymmdd(column) -%}
+    {{ exceptions.raise_compiler_error(
+        "parse_yyyymmdd is not implemented for adapter '" ~ adapter.type() ~ "'"
+    ) }}
+{%- endmacro %}
diff --git a/macros/safe_divide.sql b/macros/safe_divide.sql
new file mode 100644
index 0000000..6d7540e
--- /dev/null
+++ b/macros/safe_divide.sql
@@ -0,0 +1,13 @@
+{#
+    Divide two SQL expressions, returning NULL when the denominator is zero or NULL.
+
+    Snowflake raises an error on x / 0. A ratio with a zero denominator is
+    undefined, and NULL is the honest representation of "undefined" -- a huge
+    number or a zero would both be lies that end up on a dashboard.
+
+    Both sides are cast to double: these are ratios, so floating point is the
+    right type, and it keeps results identical on Snowflake and DuckDB.
+#}
+{% macro safe_divide(numerator, denominator) -%}
+    (cast({{ numerator }} as double) / nullif(cast({{ denominator }} as double), 0))
+{%- endmacro %}
diff --git a/macros/statement_helpers.sql b/macros/statement_helpers.sql
new file mode 100644
index 0000000..5d03077
--- /dev/null
+++ b/macros/statement_helpers.sql
@@ -0,0 +1,27 @@
+{#
+    Helpers shared by the statement pivots and filing models, so the definition
+    of "primary financial statement" and the pivot pattern live in one place.
+#}
+
+{# Statement codes that make a filing count as containing financial statements. #}
+{% macro primary_statement_codes() -%}
+    ('BS', 'IS', 'CF')
+{%- endmacro %}
+
+
+{#
+    One column per concept from (concept, fact_value, tag) rows that have
+    already been reduced to one row per concept, plus a <concept>_tag column for
+    selected concepts recording which XBRL tag supplied the value (lineage that
+    reconciliation tests and analysts can check).
+#}
+{% macro pivot_concepts(concepts, with_source_tag=[]) -%}
+    {%- for concept in concepts %}
+        max(case when concept = '{{ concept }}' then fact_value end) as {{ concept }}
+        {%- if not loop.last or with_source_tag %},{% endif %}
+    {%- endfor %}
+    {%- for concept in with_source_tag %}
+        max(case when concept = '{{ concept }}' then tag end) as {{ concept }}_tag
+        {%- if not loop.last %},{% endif %}
+    {%- endfor %}
+{%- endmacro %}
