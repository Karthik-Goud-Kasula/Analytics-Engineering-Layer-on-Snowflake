new file mode 100644
index 0000000..9b592be
--- /dev/null
+++ b/scripts/check_project.py
@@ -0,0 +1,125 @@
+#!/usr/bin/env python3
+"""Project hygiene checks that dbt itself does not enforce.
+
+    python scripts/check_project.py              # needs target/manifest.json (dbt parse)
+    python scripts/check_project.py --catalog    # also needs target/catalog.json (dbt docs generate)
+
+Checks:
+  1. Every model has a description and at least one data test or unit test.
+     An undocumented, untested model is one nobody can safely reuse.
+  2. Every mart column is documented with a description and a data_type
+     (they feed docs/DATA_DICTIONARY.md).
+  3. With --catalog: the documented columns of each mart match the columns the
+     built table really has -- no stale docs, no undocumented columns.
+  4. profiles/profiles.yml contains no literal credentials: every credential
+     field must be an env_var() lookup.
+
+Exits 1 and lists every problem found.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import sys
+from pathlib import Path
+
+import yaml
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+CREDENTIAL_FIELDS = {
+    "account", "user", "password", "private_key", "private_key_path",
+    "private_key_passphrase", "token", "oauth_client_secret", "refresh_token",
+}  # fmt: skip
+ENV_VAR_ONLY = re.compile(r"^\s*\{\{\s*env_var\(\s*'[A-Z0-9_]+'\s*(,\s*'[^']*'\s*)?\)\s*\}\}\s*$")
+
+
+def load_json(path: Path) -> dict:
+    if not path.exists():
+        sys.exit(f"error: {path} not found. Run `dbt parse` (and `dbt docs generate` for --catalog).")
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def check_models(manifest: dict) -> list[str]:
+    problems = []
+    tested: set[str] = set()
+    for node in list(manifest["nodes"].values()) + list(manifest.get("unit_tests", {}).values()):
+        if node["resource_type"] in ("test", "unit_test"):
+            tested.update(n for n in node["depends_on"]["nodes"] if n.startswith("model."))
+
+    for unique_id, node in manifest["nodes"].items():
+        if node["resource_type"] != "model" or node["package_name"] != "sec_analytics":
+            continue
+        name = node["name"]
+        if not node.get("description", "").strip():
+            problems.append(f"{name}: model has no description")
+        if unique_id not in tested:
+            problems.append(f"{name}: model has no data tests or unit tests")
+        if "/marts/" in node["original_file_path"]:
+            for column, spec in node.get("columns", {}).items():
+                if not spec.get("description", "").strip():
+                    problems.append(f"{name}.{column}: mart column has no description")
+                if not spec.get("data_type"):
+                    problems.append(f"{name}.{column}: mart column has no data_type")
+    return problems
+
+
+def check_catalog(manifest: dict, catalog: dict) -> list[str]:
+    problems = []
+    for unique_id, node in manifest["nodes"].items():
+        if node["resource_type"] != "model" or "/marts/" not in node["original_file_path"]:
+            continue
+        built = catalog["nodes"].get(unique_id)
+        if built is None:
+            problems.append(f"{node['name']}: not in catalog.json (was it built?)")
+            continue
+        actual = {c.lower() for c in built["columns"]}
+        documented = {c.lower() for c in node.get("columns", {})}
+        for column in sorted(actual - documented):
+            problems.append(f"{node['name']}.{column}: column exists but is not documented")
+        for column in sorted(documented - actual):
+            problems.append(f"{node['name']}.{column}: documented but not in the built table")
+    return problems
+
+
+def check_profiles(path: Path) -> list[str]:
+    problems = []
+    profiles = yaml.safe_load(path.read_text(encoding="utf-8"))
+    for profile_name, profile in profiles.items():
+        for target_name, output in profile.get("outputs", {}).items():
+            for field, value in output.items():
+                if field in CREDENTIAL_FIELDS and not ENV_VAR_ONLY.match(str(value)):
+                    problems.append(
+                        f"{path.name}: {profile_name}.{target_name}.{field} must be an "
+                        "env_var() lookup, not a literal value"
+                    )
+    return problems
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--catalog", action="store_true", help="Also check catalog.json")
+    args = parser.parse_args()
+
+    manifest = load_json(REPO_ROOT / "target" / "manifest.json")
+    problems = check_models(manifest)
+    if args.catalog:
+        problems += check_catalog(manifest, load_json(REPO_ROOT / "target" / "catalog.json"))
+    problems += check_profiles(REPO_ROOT / "profiles" / "profiles.yml")
+
+    if problems:
+        print(f"{len(problems)} problem(s) found:")
+        for problem in problems:
+            print(f"  - {problem}")
+        return 1
+    models = sum(
+        1 for n in manifest["nodes"].values()
+        if n["resource_type"] == "model" and n["package_name"] == "sec_analytics"
+    )  # fmt: skip
+    print(f"OK: {models} models documented and tested; profiles contain no literal credentials.")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/check_snowflake_sql.py b/scripts/check_snowflake_sql.py
new file mode 100644
index 0000000..5ef36cf
--- /dev/null
+++ b/scripts/check_snowflake_sql.py
@@ -0,0 +1,169 @@
+#!/usr/bin/env python3
+"""Offline Snowflake SQL check: compile every model for Snowflake and parse it.
+
+No Snowflake account is needed, and none is contacted. The script:
+
+1. copies the dbt project to a temporary directory;
+2. compiles it with the real dbt-snowflake adapter against a profile whose
+   account does not exist, with cache population off -- any model that tried
+   to query the warehouse would fail loudly here;
+3. compiles twice, with is_incremental() stubbed to true and to false, because
+   asking whether the incremental table exists is the one thing that would
+   otherwise need a connection -- so both branches of fct_financial_facts are
+   checked;
+4. parses every compiled model, test and analysis, plus the hand-written
+   scripts in snowflake/, with sqlfluff's Snowflake grammar, and the compiled
+   SQL also with sqlglot's.
+
+What this proves: the SQL dbt would send to Snowflake is syntactically valid.
+What it does NOT prove: that it runs (functions, types, privileges, data).
+That needs a real account: see README > Snowflake setup.
+
+    python scripts/check_snowflake_sql.py
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+import sqlglot
+from sqlglot.errors import ParseError
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+PROJECT_FILES = ["dbt_project.yml", "packages.yml", "package-lock.yml"]
+PROJECT_DIRS = ["models", "macros", "tests", "seeds", "analyses", "dbt_packages"]
+
+OFFLINE_PROFILE = """\
+sec_analytics:
+  target: snowflake_offline
+  outputs:
+    snowflake_offline:
+      type: snowflake
+      account: offline-compile-check.invalid
+      user: offline
+      password: not-a-credential
+      role: SEC_TRANSFORMER
+      database: SEC_ANALYTICS_DEV
+      warehouse: SEC_TRANSFORM_WH
+      schema: dbt_offline
+      threads: 4
+      connect_timeout: 5
+      connect_retries: 0
+"""
+
+
+def compile_project(workdir: Path, incremental: bool) -> Path:
+    stub = workdir / "macros" / "zz_offline_is_incremental.sql"
+    stub.write_text(
+        "{% macro is_incremental() %}{{ return(" + str(incremental) + ") }}{% endmacro %}\n",
+        encoding="utf-8",
+    )
+    target = workdir / f"target_incremental_{str(incremental).lower()}"
+    # dbt reads DBT_* environment variables as CLI flags (DBT_TARGET acts as
+    # --target), so strip any inherited ones and pass everything explicitly.
+    env = {key: value for key, value in os.environ.items() if not key.startswith("DBT_")}
+    result = subprocess.run(
+        [
+            "dbt",
+            "compile",
+            "--profiles-dir",
+            str(workdir),
+            "--target",
+            "snowflake_offline",
+            "--target-path",
+            str(target),
+            "--no-populate-cache",
+            "--exclude",
+            "test_type:unit",
+        ],
+        cwd=workdir,
+        env=env,
+        capture_output=True,
+        text=True,
+    )
+    if result.returncode != 0:
+        print(result.stdout[-3000:], result.stderr[-3000:], sep="\n")
+        raise SystemExit(f"dbt compile for Snowflake failed (is_incremental={incremental})")
+    print(f"  compiled for Snowflake with is_incremental() = {incremental}")
+    return target / "compiled"
+
+
+def sqlfluff_parse_errors(files: list[Path]) -> list[str]:
+    result = subprocess.run(
+        [
+            "sqlfluff",
+            "lint",
+            "--dialect",
+            "snowflake",
+            "--templater",
+            "raw",
+            "--rules",
+            "LT01",
+            "--nofail",
+            "--format",
+            "json",
+            *map(str, files),
+        ],  # fmt: skip
+        capture_output=True,
+        text=True,
+    )
+    errors = []
+    for item in json.loads(result.stdout or "[]"):
+        for violation in item["violations"]:
+            if violation["code"] == "PRS":
+                errors.append(
+                    f"{item['filepath']}:{violation['start_line_no']}: {violation['description'][:160]}"
+                )
+                break
+    return errors
+
+
+def sqlglot_parse_errors(files: list[Path]) -> list[str]:
+    errors = []
+    for path in files:
+        try:
+            sqlglot.parse(path.read_text(encoding="utf-8"), read="snowflake")
+        except ParseError as exc:
+            errors.append(f"{path}: {str(exc).splitlines()[0][:160]}")
+    return errors
+
+
+def main() -> int:
+    with tempfile.TemporaryDirectory(prefix="sec_snowflake_check_") as tmp:
+        workdir = Path(tmp)
+        for name in PROJECT_FILES:
+            shutil.copy2(REPO_ROOT / name, workdir / name)
+        for name in PROJECT_DIRS:
+            if not (REPO_ROOT / name).exists():
+                raise SystemExit(f"{name}/ not found (run `dbt deps` first for dbt_packages)")
+            shutil.copytree(REPO_ROOT / name, workdir / name)
+        (workdir / "profiles.yml").write_text(OFFLINE_PROFILE, encoding="utf-8")
+
+        compiled_dirs = [compile_project(workdir, True), compile_project(workdir, False)]
+        compiled = sorted(
+            {p for d in compiled_dirs for p in (d / "sec_analytics").rglob("*.sql")}
+        )  # fmt: skip
+        scripts = sorted((REPO_ROOT / "snowflake").rglob("*.sql"))
+
+        fluff_errors = sqlfluff_parse_errors(compiled + scripts)
+        glot_errors = sqlglot_parse_errors(compiled)
+
+    print(f"  sqlfluff (Snowflake grammar): {len(compiled)} compiled files + {len(scripts)} setup scripts")
+    print(f"  sqlglot  (Snowflake grammar): {len(compiled)} compiled files")
+    for error in fluff_errors + glot_errors:
+        print(f"    {error}")
+    if fluff_errors or glot_errors:
+        print("FAILED: Snowflake SQL does not parse")
+        return 1
+    print("PASSED: all compiled SQL and setup scripts parse as Snowflake SQL")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/reconcile_incremental.py b/scripts/reconcile_incremental.py
new file mode 100644
index 0000000..eb7c077
--- /dev/null
+++ b/scripts/reconcile_incremental.py
@@ -0,0 +1,181 @@
+#!/usr/bin/env python3
+"""Prove the incremental pipeline gives the same answer as a full rebuild.
+
+Builds two local DuckDB warehouses from the sample data:
+
+  A (incremental), loaded the way production data arrives:
+      1. initial load 2023q2-2024q1          -> dbt build (first run)
+      2. new quarter 2024q2                  -> dbt build (incremental)
+      3. re-run with nothing new             -> dbt build (must change nothing)
+      4. backfill OLDER quarter 2023q1       -> dbt build (incremental)
+      5. re-deliver 2024q1 (same content)    -> dbt build (must not duplicate)
+
+  B (reference): load everything at once -> dbt build --full-refresh
+
+Then compares every mart table in A and B row by row (EXCEPT in both
+directions), ignoring only load timestamps. Also checks, after each step, that
+fct_financial_facts has exactly one row per staged fact.
+
+Step 4 is the case a filed_date watermark gets wrong: every backfilled filing
+is older than the newest filing already loaded. The script reports how many
+facts such a watermark would have skipped.
+
+    python scripts/reconcile_incremental.py
+"""
+
+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import duckdb
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+WAREHOUSE_DIR = REPO_ROOT / "data" / "warehouse"
+DB_INCREMENTAL = WAREHOUSE_DIR / "reconcile_incremental.duckdb"
+DB_FULL = WAREHOUSE_DIR / "reconcile_full_refresh.duckdb"
+
+MART_SCHEMA = "analytics_marts"
+# Columns that legitimately differ between the two builds: when rows were loaded.
+IGNORED_COLUMNS = {"loaded_at"}
+
+
+def run(command: list[str], db: Path) -> None:
+    env = {**os.environ, "DUCKDB_PATH": str(db), "DBT_TARGET": "local",
+           "DBT_PROFILES_DIR": str(REPO_ROOT / "profiles")}  # fmt: skip
+    result = subprocess.run(command, cwd=REPO_ROOT, env=env, capture_output=True, text=True)
+    summary = [line for line in result.stdout.splitlines() if "Done. PASS=" in line]
+    label = " ".join(command[:3]) if command[0] != "dbt" else " ".join(command)
+    print(f"    $ {label}" + (f"\n      {summary[-1].split('  ', 1)[-1].strip()}" if summary else ""))
+    if result.returncode != 0:
+        print(result.stdout[-4000:], result.stderr[-4000:], sep="\n")
+        raise SystemExit(f"command failed: {' '.join(command)}")
+
+
+def load(db: Path, *quarters: str) -> None:
+    run([sys.executable, "-m", "ingestion.load_sec_data", "--target", "duckdb",
+         "--source", "sample", "--duckdb-path", str(db), "--quarters", *quarters], db)  # fmt: skip
+
+
+def build(db: Path, *extra: str) -> None:
+    run(["dbt", "build", "--target", "local", *extra], db)
+
+
+def query(db: Path, sql: str):
+    con = duckdb.connect(str(db), read_only=True)
+    try:
+        return con.execute(sql).fetchall()
+    finally:
+        con.close()
+
+
+def assert_facts_reconcile(db: Path, step: str) -> int:
+    staged, built, distinct = query(
+        db,
+        "select (select count(*) from analytics_staging.stg_sec__numeric_facts), "
+        "count(*), count(distinct fact_key) from analytics_marts.fct_financial_facts",
+    )[0]
+    status = "OK" if staged == built == distinct else "MISMATCH"
+    print(f"    fct_financial_facts: {built} rows, {distinct} distinct, {staged} staged -> {status}")
+    if status != "OK":
+        raise SystemExit(f"{step}: incremental fact table does not reconcile with staging")
+    return built
+
+
+def compare_marts() -> list[str]:
+    con = duckdb.connect()
+    con.execute(f"attach '{DB_INCREMENTAL}' as inc (read_only)")
+    con.execute(f"attach '{DB_FULL}' as ref (read_only)")
+    tables = [row[0] for row in con.execute(
+        "select table_name from information_schema.tables "
+        f"where table_catalog = 'inc' and table_schema = '{MART_SCHEMA}' order by table_name"
+    ).fetchall()]  # fmt: skip
+    failures = []
+    for table in tables:
+        columns = [row[0] for row in con.execute(
+            "select column_name from information_schema.columns where table_catalog = 'inc' "
+            f"and table_schema = '{MART_SCHEMA}' and table_name = '{table}' order by ordinal_position"
+        ).fetchall() if row[0] not in IGNORED_COLUMNS]  # fmt: skip
+        column_list = ", ".join(f'"{c}"' for c in columns)
+        a = f"select {column_list} from inc.{MART_SCHEMA}.{table}"
+        b = f"select {column_list} from ref.{MART_SCHEMA}.{table}"
+        only_a = con.execute(f"select count(*) from ({a} except all {b})").fetchone()[0]
+        only_b = con.execute(f"select count(*) from ({b} except all {a})").fetchone()[0]
+        rows = con.execute(f"select count(*) from ({a})").fetchone()[0]
+        ok = only_a == 0 and only_b == 0
+        print(f"    {table:<36} {rows:>6} rows  {'identical' if ok else f'DIFFERS ({only_a} / {only_b})'}")
+        if not ok:
+            failures.append(table)
+    return failures
+
+
+def main() -> int:
+    WAREHOUSE_DIR.mkdir(parents=True, exist_ok=True)
+    for db in (DB_INCREMENTAL, DB_FULL):
+        db.unlink(missing_ok=True)
+
+    print("A. Incremental warehouse")
+    print("  1. Initial load (2023q2-2024q1) and first build")
+    load(DB_INCREMENTAL, "2023q2:2024q1")
+    build(DB_INCREMENTAL)
+    first_rows = assert_facts_reconcile(DB_INCREMENTAL, "step 1")
+    first_loaded_at = query(DB_INCREMENTAL, "select max(loaded_at) from analytics_marts.fct_financial_facts")[
+        0
+    ][0]
+
+    print("  2. New quarter 2024q2, incremental build")
+    load(DB_INCREMENTAL, "2024q2")
+    build(DB_INCREMENTAL)
+    assert_facts_reconcile(DB_INCREMENTAL, "step 2")
+    untouched = query(
+        DB_INCREMENTAL,
+        "select count(*) from analytics_marts.fct_financial_facts "
+        f"where source_quarter <> '2024q2' and loaded_at <= '{first_loaded_at}'",
+    )[0][0]
+    print(f"    rows from step 1 left untouched by the incremental run: {untouched} of {first_rows}")
+    if untouched != first_rows:
+        raise SystemExit("step 2: the incremental run rewrote rows it should not have touched")
+
+    print("  3. Re-run with no new data")
+    before = query(DB_INCREMENTAL, "select count(*) from analytics_marts.fct_financial_facts")[0][0]
+    build(DB_INCREMENTAL)
+    after = assert_facts_reconcile(DB_INCREMENTAL, "step 3")
+    if after != before:
+        raise SystemExit("step 3: a no-op run changed the fact table")
+
+    print("  4. Backfill an OLDER quarter (2023q1) after newer data")
+    newest_filed = query(DB_INCREMENTAL, "select max(filed_date) from analytics_marts.dim_filing")[0][0]
+    load(DB_INCREMENTAL, "2023q1")
+    build(DB_INCREMENTAL)
+    assert_facts_reconcile(DB_INCREMENTAL, "step 4")
+    skipped = query(
+        DB_INCREMENTAL,
+        "select count(*) from analytics_marts.fct_financial_facts f "
+        "join analytics_marts.dim_filing d on f.filing_id = d.filing_id "
+        f"where f.source_quarter = '2023q1' and d.filed_date <= '{newest_filed}'",
+    )[0][0]
+    print(f"    backfilled facts a filed_date watermark (> {newest_filed}) would have skipped: {skipped}")
+
+    print("  5. Re-deliver 2024q1 with identical content")
+    load(DB_INCREMENTAL, "2024q1")
+    build(DB_INCREMENTAL)
+    assert_facts_reconcile(DB_INCREMENTAL, "step 5")
+
+    print("B. Reference warehouse: everything at once, --full-refresh")
+    load(DB_FULL, "2023q1:2024q2")
+    build(DB_FULL, "--full-refresh")
+    assert_facts_reconcile(DB_FULL, "reference")
+
+    print("C. Compare every mart table (A vs B)")
+    failures = compare_marts()
+    if failures:
+        print(f"FAILED: {len(failures)} table(s) differ: {', '.join(failures)}")
+        return 1
+    print("PASSED: incremental and full-refresh builds are identical.")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
