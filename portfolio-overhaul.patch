+*/
+
+select
+    growth.fiscal_year,
+    growth.company_name,
+    growth.sector,
+    growth.prior_revenue,
+    growth.revenue,
+    round(growth.revenue_growth_rate, 4) as revenue_growth_rate,
+    round(growth.net_income_growth_rate, 4) as net_income_growth_rate
