diff --git a/snowflake/queries/verify_outputs.sql b/snowflake/queries/verify_outputs.sql
new file mode 100644
index 0000000..13bf47b
--- /dev/null
+++ b/snowflake/queries/verify_outputs.sql
@@ -0,0 +1,47 @@
+/*
+    Verify a Snowflake build of the SAMPLE data against the expected results
+    documented in docs/EXPECTED_OUTPUTS.md. Run as SEC_TRANSFORMER (or
+    SEC_ANALYST) after `make load-sample TARGET=dev` and `make build TARGET=dev`.
+
+    Replace DBT_YOURNAME with your DBT_SNOWFLAKE_SCHEMA value. Each query states
+    its expected result; any other result means the build is wrong.
+*/
+
+use warehouse sec_transform_wh;
+use database sec_analytics_dev;
+
+-- 1. Row counts. Expected: 15 annual rows, 26 quarterly rows, 10 companies,
+--    1 restatement, 1 sector benchmark, 2116 atomic facts.
+select 'fct_company_financials_annual' as model, count(*) as row_count
+from dbt_yourname_marts.fct_company_financials_annual
+union all select 'fct_company_financials_quarterly', count(*) from dbt_yourname_marts.fct_company_financials_quarterly
+union all select 'dim_company', count(*) from dbt_yourname_marts.dim_company
+union all select 'mart_restatements', count(*) from dbt_yourname_marts.mart_restatements
+union all select 'mart_sector_benchmarks', count(*) from dbt_yourname_marts.mart_sector_benchmarks
+union all select 'fct_financial_facts', count(*) from dbt_yourname_marts.fct_financial_facts;
+
+-- 2. Tag priority and as-reported values. Expected: ALDER 2022 revenue
+--    410000000 and 2023 revenue 480000000 (not 482500000 from "Revenues",
+--    not the 1%-recast comparative), both from the ASC 606 tag.
+select fiscal_year, revenue, revenue_tag, net_income, eps_basic
+from dbt_yourname_marts.fct_company_financials_annual
+where company_name = 'ALDER SOFTWARE INC'
+order by fiscal_year;
+
+-- 3. Derived Q4. Expected: ALDER fiscal 2023 Q4 revenue 134400000, is_derived_q4 = true.
+select fiscal_quarter, revenue, is_derived_q4, has_complete_quarters
+from dbt_yourname_marts.fct_company_financials_quarterly
+where company_name = 'ALDER SOFTWARE INC' and fiscal_year = 2023
+order by fiscal_quarter;
+
+-- 4. Restatement. Expected: one BIRCH row, net income 36656000 -> 28756000,
+--    change rate about -0.2155, is_material_restatement = true.
+select company_name, original_net_income, restated_net_income,
+       round(net_income_change_rate, 4) as change_rate, is_material_restatement
+from dbt_yourname_marts.mart_restatements;
+
+-- 5. SCD2. Expected: BIRCH has 2 versions; only BIRCH CLOUD INC is current.
+select version_number, company_name, valid_from, valid_to, is_current
+from dbt_yourname_marts.dim_company_history
+where cik = 9900002
+order by version_number;
diff --git a/snowflake/setup/01_account_setup.sql b/snowflake/setup/01_account_setup.sql
new file mode 100644
index 0000000..704ffed
--- /dev/null
+++ b/snowflake/setup/01_account_setup.sql
@@ -0,0 +1,137 @@
+/*
+    SEC Analytics -- one-time Snowflake setup (development environment).
+
+    WHO RUNS THIS: a user holding USERADMIN, SYSADMIN and SECURITYADMIN. In a
+    trial account, the user who created the account has all three. ACCOUNTADMIN
+    is NOT required, except for the optional resource monitor in step 6.
+
+    WHAT IT CREATES (all new, all prefixed SEC_; nothing existing is touched):
+        roles      SEC_LOADER, SEC_TRANSFORMER, SEC_ANALYST
+        warehouse  SEC_TRANSFORM_WH (X-Small, suspends after 60 s idle)
+        database   SEC_ANALYTICS_DEV, with schema RAW_SEC
+        user       SEC_CI_SVC (service user for the optional GitHub workflow)
+
+    Idempotent: every statement is CREATE ... IF NOT EXISTS or a GRANT, so it is
+    safe to re-run.
+
+    Least privilege:
+        SEC_LOADER       owns RAW_SEC; can write raw files. Nothing else.
+        SEC_TRANSFORMER  reads RAW_SEC; creates and owns the schemas dbt builds.
+                         Cannot modify raw data.
+        SEC_ANALYST      reads what dbt builds. Cannot read raw data.
+*/
+
+-- -------------------------------------------------------------------------
+-- 1. Roles (USERADMIN owns roles and users)
+-- -------------------------------------------------------------------------
+use role useradmin;
+
+create role if not exists sec_loader
+    comment = 'SEC Analytics: loads raw SEC files into RAW_SEC';
+create role if not exists sec_transformer
+    comment = 'SEC Analytics: runs dbt; reads RAW_SEC, owns dbt schemas';
+create role if not exists sec_analyst
+    comment = 'SEC Analytics: read-only access to dbt models';
+
+-- Roll the custom roles up to SYSADMIN so administrators can manage
+-- everything they own (Snowflake's recommended role hierarchy).
+grant role sec_loader to role sysadmin;
+grant role sec_transformer to role sysadmin;
+grant role sec_analyst to role sysadmin;
+
+-- -------------------------------------------------------------------------
+-- 2. Compute and storage (SYSADMIN owns warehouses and databases)
+-- -------------------------------------------------------------------------
+use role sysadmin;
+
+create warehouse if not exists sec_transform_wh
+    warehouse_size = xsmall
+    auto_suspend = 60                     -- seconds idle before suspending
+    auto_resume = true
+    initially_suspended = true
+    statement_timeout_in_seconds = 900    -- cost guard: kill runaway queries
+    comment = 'SEC Analytics: loading and dbt transformations';
+
+create database if not exists sec_analytics_dev
+    comment = 'SEC Analytics: development (raw data + dbt output)';
+
+create schema if not exists sec_analytics_dev.raw_sec
+    comment = 'Raw SEC Financial Statement Data Sets, loaded as-is (all VARCHAR)';
+
+grant usage on warehouse sec_transform_wh to role sec_loader;
+grant usage on warehouse sec_transform_wh to role sec_transformer;
+grant usage on warehouse sec_transform_wh to role sec_analyst;
+
+grant usage on database sec_analytics_dev to role sec_loader;
+grant usage on database sec_analytics_dev to role sec_transformer;
+grant usage on database sec_analytics_dev to role sec_analyst;
+
+-- dbt creates its own schemas: dbt_<you>_staging, ci_<run>_marts, ...
+grant create schema on database sec_analytics_dev to role sec_transformer;
+
+-- The transformer may read the raw schema...
+grant usage on schema sec_analytics_dev.raw_sec to role sec_transformer;
+
+-- ...which the loader owns. COPY CURRENT GRANTS keeps the usage grant above.
+grant ownership on schema sec_analytics_dev.raw_sec
+    to role sec_loader copy current grants;
+
+-- -------------------------------------------------------------------------
+-- 3. Future grants (need MANAGE GRANTS, which SECURITYADMIN holds)
+-- -------------------------------------------------------------------------
+use role securityadmin;
+
+-- The transformer can SELECT every raw table, including ones created later.
+grant select on all tables in schema sec_analytics_dev.raw_sec to role sec_transformer;
+grant select on future tables in schema sec_analytics_dev.raw_sec to role sec_transformer;
+
+-- The analyst can read every schema, table and view dbt creates. dbt replaces
+-- tables with CREATE OR REPLACE, which creates a new object, so these future
+-- grants apply on every rebuild; no grant hook is needed in dbt.
+-- RAW_SEC is unaffected: it already exists (not a "future" schema), and its
+-- schema-level future grant above takes precedence over database-level ones.
+grant usage on future schemas in database sec_analytics_dev to role sec_analyst;
+grant select on future tables in database sec_analytics_dev to role sec_analyst;
+grant select on future views in database sec_analytics_dev to role sec_analyst;
+
+-- -------------------------------------------------------------------------
+-- 4. Your own user (for running the loader and dbt locally)
+-- -------------------------------------------------------------------------
+use role useradmin;
+
+-- Replace <YOUR_USER> and run these two lines:
+-- grant role sec_loader to user <YOUR_USER>;
+-- grant role sec_transformer to user <YOUR_USER>;
+
+-- Key-pair authentication (see README > Snowflake setup to generate the key),
+-- then paste the public key body without the BEGIN/END lines:
+-- alter user <YOUR_USER> set rsa_public_key = '<PUBLIC_KEY_BODY>';
+
+-- -------------------------------------------------------------------------
+-- 5. Service user for the optional GitHub Actions integration workflow
+-- -------------------------------------------------------------------------
+-- TYPE = SERVICE: no password and no interactive login; key-pair only.
+create user if not exists sec_ci_svc
+    type = service
+    default_role = sec_transformer
+    default_warehouse = sec_transform_wh
+    comment = 'SEC Analytics: GitHub Actions integration workflow';
+
+grant role sec_transformer to user sec_ci_svc;
+
+-- Generate a SEPARATE key pair for CI, store the private key as the GitHub
+-- secret SNOWFLAKE_PRIVATE_KEY, then:
+-- alter user sec_ci_svc set rsa_public_key = '<CI_PUBLIC_KEY_BODY>';
+
+-- -------------------------------------------------------------------------
+-- 6. Optional cost guard (requires ACCOUNTADMIN)
+-- -------------------------------------------------------------------------
+-- use role accountadmin;
+-- create resource monitor if not exists sec_dev_monitor
+--     with credit_quota = 10
+--     frequency = monthly
+--     start_timestamp = immediately
+--     triggers
+--         on 80 percent do notify
+--         on 100 percent do suspend;
+-- alter warehouse sec_transform_wh set resource_monitor = sec_dev_monitor;
diff --git a/snowflake/setup/02_raw_tables.sql b/snowflake/setup/02_raw_tables.sql
new file mode 100644
index 0000000..f55163e
--- /dev/null
+++ b/snowflake/setup/02_raw_tables.sql
@@ -0,0 +1,128 @@
+/*
+    SEC Analytics -- raw landing objects. Run AFTER 01_account_setup.sql.
+
+    WHO RUNS THIS: a user granted SEC_LOADER (the owner of RAW_SEC).
+
+    Creates the file format, the internal stage and the four raw tables. Every
+    source column is VARCHAR: nothing is cast at load time, so a malformed value
+    can never make the load drop a row. Typing happens in dbt staging, where it
+    is tested.
+
+    The column lists must match ingestion/sec_layout.py (the loader maps file
+    columns by name onto these). python_tests/test_sec_layout.py enforces that.
+*/
+
+use role sec_loader;
+use warehouse sec_transform_wh;
+use schema sec_analytics_dev.raw_sec;
+
+-- The SEC files are tab-delimited, UTF-8, with a header row and no quoting.
+create file format if not exists sec_tsv
+    type = csv
+    field_delimiter = '\t'
+    skip_header = 1
+    -- No quoting in the source: a literal " in a company name is a character.
+    field_optionally_enclosed_by = none
+    -- Backslashes are data, not escape characters.
+    escape_unenclosed_field = none
+    empty_field_as_null = true
+    encoding = 'UTF8'
+    comment = 'SEC Financial Statement Data Sets text files';
+
+-- Internal stage: the loader PUTs files here, COPYs them, then removes them.
+create stage if not exists sec_stage
+    file_format = (format_name = 'sec_tsv')
+    comment = 'Transient landing area for SEC files during a load';
+
+create table if not exists sub (
+    adsh varchar,
+    cik varchar,
+    name varchar,
+    sic varchar,
+    countryba varchar,
+    stprba varchar,
+    cityba varchar,
+    zipba varchar,
+    bas1 varchar,
+    bas2 varchar,
+    baph varchar,
+    countryma varchar,
+    stprma varchar,
+    cityma varchar,
+    zipma varchar,
+    mas1 varchar,
+    mas2 varchar,
+    countryinc varchar,
+    stprinc varchar,
+    ein varchar,
+    former varchar,
+    changed varchar,
+    afs varchar,
+    wksi varchar,
+    fye varchar,
+    form varchar,
+    period varchar,
+    fy varchar,
+    fp varchar,
+    filed varchar,
+    accepted varchar,
+    prevrpt varchar,
+    detail varchar,
+    instance varchar,
+    nciks varchar,
+    aciks varchar,
+    _source_quarter varchar comment 'SEC data set quarter, e.g. 2024q1',
+    _source_file varchar comment 'Staged file the row was loaded from',
+    _loaded_at timestamp_ltz comment 'When the loader wrote the row'
+)
+comment = 'SEC sub.txt, loaded as-is';
+
+create table if not exists num (
+    adsh varchar,
+    tag varchar,
+    version varchar,
+    ddate varchar,
+    qtrs varchar,
+    uom varchar,
+    segments varchar,
+    coreg varchar,
+    value varchar,
+    footnote varchar,
+    _source_quarter varchar comment 'SEC data set quarter, e.g. 2024q1',
+    _source_file varchar comment 'Staged file the row was loaded from',
+    _loaded_at timestamp_ltz comment 'When the loader wrote the row'
+)
+comment = 'SEC num.txt, loaded as-is';
+
+create table if not exists tag (
+    tag varchar,
+    version varchar,
+    custom varchar,
+    abstract varchar,
+    datatype varchar,
+    iord varchar,
+    crdr varchar,
+    tlabel varchar,
+    doc varchar,
+    _source_quarter varchar comment 'SEC data set quarter, e.g. 2024q1',
+    _source_file varchar comment 'Staged file the row was loaded from',
+    _loaded_at timestamp_ltz comment 'When the loader wrote the row'
+)
+comment = 'SEC tag.txt, loaded as-is';
+
+create table if not exists pre (
+    adsh varchar,
+    report varchar,
+    line varchar,
+    stmt varchar,
+    inpth varchar,
+    rfile varchar,
+    tag varchar,
+    version varchar,
+    plabel varchar,
+    negating varchar,
+    _source_quarter varchar comment 'SEC data set quarter, e.g. 2024q1',
+    _source_file varchar comment 'Staged file the row was loaded from',
+    _loaded_at timestamp_ltz comment 'When the loader wrote the row'
+)
+comment = 'SEC pre.txt, loaded as-is';
diff --git a/snowflake/setup/99_teardown.sql b/snowflake/setup/99_teardown.sql
